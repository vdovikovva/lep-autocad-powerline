;; Подложка

(setq *LEP-Layer-Kadastr*       "LEP-KADASTR")


;; Служебная линия маршрута (LEP-ROUTE) - НЕ настоящий ВЛ/КЛ, просто
;; "арматура" для констрейнтов опор. Печать всегда выключена (см.
;; LEP-SETUP), видимость на экране переключается командой
;; LEP-ROUTEVIS, чтобы не перекрывать пунктир пролётов КЛ.

(setq *LEP-Layer-Route*         "LEP-ROUTE-SERVICE")


;; Воздушные линии

(setq *LEP-Layer-Proj-VL*       "LEP-PROJ-VL")
(setq *LEP-Layer-Exist-VL*      "LEP-EXIST-VL")


;; Кабельные линии

(setq *LEP-Layer-Proj-KL*       "LEP-PROJ-KL")
(setq *LEP-Layer-Exist-KL*      "LEP-EXIST-KL")


;; Опоры

(setq *LEP-Layer-Proj-Pole*     "LEP-PROJ-POLES")
(setq *LEP-Layer-Exist-Pole*    "LEP-EXIST-POLES")


;; Подстанции

(setq *LEP-Layer-Proj-MTP*      "LEP-PROJ-MTP")
(setq *LEP-Layer-Proj-RLK*      "LEP-PROJ-RLK")
(setq *LEP-Layer-Exist-TP*      "LEP-EXIST-TP")
(setq *LEP-Layer-Proj-TP*       "LEP-PROJ-TP")


;; Текст

(setq *LEP-Layer-Text*          "LEP-TEXT")
(setq *LEP-LeaderOffset* 5.0)   ; метров (после калибровки 1 ед. = 1 м), можно потом подвинуть под глаз


;; Размеры

(setq *LEP-Layer-Dim*           "LEP-DIM")


;; Служебный слой "для ручного черчения" - создаётся ПОСЛЕДНИМ в
;; LEP-SETUP.LSP (см. C:LEP-SETUP). Смысл: команда "-LAYER Make" в
;; AutoCAD всегда делает только что созданный слой ТЕКУЩИМ (это
;; поведение самой команды, не наш баг - уже ловили из-за этого баг
;; с подложкой, попадавшей не на тот слой в LEP-SCALE). Раз это
;; неизбежно, пусть текущим после автозапуска LEP-SETUP (см.
;; LEP-START.LSP) остаётся НЕ технический слой (было бы плохо - любая
;; случайная линия "мимо команды" попадёт в ВЛ/КЛ/опоры и испортит
;; ведомость), а специально отведённый под ручные пометки/черновые
;; построения. Пользователь всегда может переключиться на нужный слой
;; сам - это просто безопасный дефолт.

(setq *LEP-Layer-Manual*        "LEP-MANUAL")



;=====================================================================
;                           ЦВЕТА СЛОЁВ
;=====================================================================
;
; Используются стандартные ACI цвета AutoCAD.
;
; При необходимости можно изменить здесь, не меняя код.
;
;=====================================================================

(setq *LEP-Color-Proj*          1)      ; Красный (в т.ч. служебная линия маршрута)
(setq *LEP-Color-Exist*         8)      ; Серый
(setq *LEP-Color-Text*          7)      ; Белый
(setq *LEP-Color-Dim*           7)      ; Белый
(setq *LEP-Color-Manual*        7)      ; Белый - нейтральный, не пересекается с проектными цветами
(setq *LEP-Color-Kadastr*       9)

;; ВЛ и КЛ разнесены по цвету отдельно от *LEP-Color-Proj* - удобнее
;; отличать на глаз при проектировании. Временные, пользователь сам
;; поправит после согласования с коллегой.
(setq *LEP-Color-Proj-VL*       30)     ; Оранжевый
(setq *LEP-Color-Proj-KL*       5)      ; Синий



;=====================================================================
;                     ТИПЫ ЛИНИЙ ПРОЛЁТОВ (LEP-SPAN)
;=====================================================================
;
; ВЛ рисуется сплошной линией ("CONTINUOUS", всегда есть в AutoCAD).
; КЛ - своим типом линии со штампом "К", чтобы на печати (даже ч/б)
; сразу было видно "это кабель". Такого типа линии нет в стандартном
; acad.lin - он определён в отдельном файле LEP-LINETYPES.LIN (лежит
; в той же папке с модулями, ищется через findfile).
;
;=====================================================================

(setq *LEP-Linetype-KL*         "LEP_CABLE")
(setq *LEP-LinetypeFile-KL*     "LEP-LINETYPES.LIN")



;=====================================================================
;              ЗАПАС ДЛИНЫ ПРОВОДА/КАБЕЛЯ (LEP-SPAN)
;=====================================================================
;
; Расстояние между опорами (по прямой) и реальная длина провода/кабеля,
; которую нужно закупить/проложить - РАЗНЫЕ величины:
;
; ВЛ (провод) - провод провисает между опорами (стрела провеса), из-за
; этого реальной длины нужно чуть больше, чем прямое расстояние.
; *LEP-Sag-VL* - процент запаса (по умолчанию 2%, можно менять здесь).
;
; КЛ (кабель) - кабель в земле НЕ провисает (лежит в траншее), но с
; каждой стороны пролёта ему нужно подняться от земли на опору - это
; фиксированная добавка, не проценты. *LEP-KL-Reserve* - метры запаса
; на весь пролёт (по умолчанию 6 м = 3 м с каждой стороны, одним
; числом - если когда-то понадобится разное с двух сторон, разбить на
; два отдельных значения, сейчас для черновой прикидки не принципиально).
;
; Запас на муфты/разделку кабеля (ГОСТ/нормы прокладки в траншее) -
; СОЗНАТЕЛЬНО не считаем здесь, это остаётся на усмотрение
; проектировщика при подготовке настоящей сметы, программа даёт только
; черновую прикидку.
;
;=====================================================================

(setq *LEP-Sag-VL*              2)      ; % запаса на провис ВЛ
(setq *LEP-KL-Reserve*          6.0)    ; м, запас на подъём КЛ на опору



