(setq *LEP-Label-PU*            "ПУ")

;; ✅ ДОБАВЛЕНО 2026-07-22 (по просьбе пользователя): СТП - трансформатор
;; на ОДНОЙ опоре (не путать с МТП - 3 опоры). Пока БЕЗ отдельной
;; графики (маленький квадратик сбоку - отложено, "давай пока текстом"):
;; ставится одна опора (тот же механизм, что у ПУ), подпись как у
;; обычной опоры первой строкой + вторая строка "+ СТП-XX кВА"
;; (LEP:CreatePoleLabel, ClassLabel-параметр). В отличие от
;; *LEP-MTP-Types* - БЕЗ классов напряжения в строке (пользователь
;; явно попросил именно такой, более простой формат для СТП).
(setq *LEP-STP-Types*
    '(
        ("СТП-25 кВА" . "СТП-25 кВА")
        ("СТП-40 кВА" . "СТП-40 кВА")
        ("СТП-63 кВА" . "СТП-63 кВА")
    )
)

;; ✅ ДОБАВЛЕНО 2026-07-22 (по просьбе пользователя): КТП - наземная
;; трансформаторная подстанция (НЕ на опоре, в отличие от МТП/СТП).
;; Номер/мощность/марка - СВОБОДНЫЙ ввод (пользователь: "нет живых
;; примеров из жизни чтоб допилить" список), поэтому фиксированного
;; списка здесь, в отличие от *LEP-MTP-Types*/*LEP-STP-Types*, нет -
;; см. LEP:GetString-запросы в LEP-END.LSP.
;;
;; Графика (прямоугольник + треугольник-значок трансформатора) - на
;; уже существующих, ранее НЕ использовавшихся слоях подстанций
;; (*LEP-Layer-Proj-TP*/*LEP-Layer-Exist-TP*, были заведены давно, но
;; простаивали - МТП/РЛК/ЩУ/ПУ оказались текстом без графики, а КТП
;; наконец даёт им применение).
;;
;; Размер прямоугольника - 3х5 м, ПРИКИДКА пользователя ("дальше
;; допилим", т.е. не финальное значение). Треугольник - ЗАЛИВКА ОДНИМ
;; ЦВЕТОМ (SOLID), БЕЗ градиента (пользователь явно попросил градиент
;; пока не делать) - цвет треугольника ФИКСИРОВАННЫЙ (не зависит от
;; статуса Проект/Сущ), тот же принцип, что и у серого креста в
;; символе опоры (*LEP-Color-PoleCross*).
(setq *LEP-KTP-Width*          3.0)  ; м
(setq *LEP-KTP-Height*         5.0)  ; м
(setq *LEP-Color-KTP-Symbol*   1)    ; Красный (ACI) - треугольник-значок трансформатора

;; Направление смещения подписи (угол в РАДИАНАХ, 0 = вправо, против
;; часовой стрелки) - у обычной опоры всегда 45° (вверх-вправо, как
;; было и раньше). У блока МТП три опоры стоят близко друг к другу
;; (шаг 3м/2м) - если все три подписи пустить в одну и ту же сторону,
;; они накладываются друг на друга (реальная проблема, замечена
;; пользователем 2026-07-10) - поэтому у LEP-END каждая из трёх
;; подписей уходит в СВОЮ сторону (веером), см. LEP-END.LSP.
(setq *LEP-Label-Angle-Default* (/ pi 4.0))          ; 45°, вверх-вправо (обычные опоры)
(setq *LEP-End-LabelAngle-RLK*  (* 0.75 pi))         ; 135°, вверх-влево
(setq *LEP-End-LabelAngle-MTP*  (/ pi 2.0))          ; 90°, прямо вверх
(setq *LEP-End-LabelAngle-SchU* (/ pi 4.0))          ; 45°, вверх-вправо


;=====================================================================
;         GPS-ТОЧКИ ИЗ GEOJSON (LEP-GEOPOINTS.LSP) - 2026-07-20
;=====================================================================
;
; Пользователь снимает GPS-координаты опор в поле (экспорт в GeoJSON,
; WGS84 - широта/долгота), затем нужно поставить на чертёж временные
; зелёные кружки-ориентиры в ТЕХ ЖЕ координатах, что и подоснова
; (МСК-47), чтобы рядом с ними вручную расставить настоящие символы
; опор (Сущ.). Кружки - НЕ часть постоянного чертежа, только рабочий
; ориентир, поэтому отдельный непечатаемый слой (как *LEP-Layer-Route*)
; и отдельная команда его полной очистки.
;
; ⚠️ ВАЖНО - перевод координат WGS84 -> МСК-47 делается НЕ в LISP:
; своя формула (черновая полиномиальная регрессия по 25 калибровочным
; точкам одного участка) была отвергнута - у каждой зоны МСК-47 своё
; смещение и своя нелинейность, локальная подгонка не переживает
; переезд на другой участок (см. LEP-README.md, раздел про GPS-точки,
; полная история). Вместо этого пользователь считает координаты САМ
; через сайт-конвертер (подтверждён рабочим, там указан официальный
; код EPSG:6334702 - МСК-47 зона 2 Ленинградская область, не
; самодельное приближение) - LISP только читает готовый результат.
;
; *LEP-GeoPoints-Diameter* - диаметр кружка (по просьбе пользователя,
; "просто точки", 1 метр - достаточно заметно на плане, но не мешает
; рядом расставлять настоящие опоры).
;
; *LEP-GeoPoints-LabelOffset* - на сколько метров вправо от ЦЕНТРА
; кружка ставится подпись (название точки из GeoJSON) - чуть больше
; радиуса кружка (0.5 м), чтобы подпись не наезжала на сам кружок.
;
;=====================================================================

(setq *LEP-Layer-GeoPoints*         "LEP-GEOPOINTS")
(setq *LEP-Color-GeoPoints*         3)      ; Зелёный (ACI)
(setq *LEP-GeoPoints-Diameter*      1.0)    ; м
(setq *LEP-GeoPoints-LabelOffset*   0.8)    ; м, от центра кружка вправо



(princ
  (strcat
    "\n"
    "=========================================\n"
    " LEP CONFIG "
    *LEP-Version*
    " загружен.\n"
    "========================================="
  )
)

(princ)