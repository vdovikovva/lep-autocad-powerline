;=====================================================================
;
;  ПРОЕКТ:      LEP (Автоматизация проектирования ЛЭП)
;
;  ФАЙЛ:        LEP-CONFIG.LSP
;
;  ВЕРСИЯ:      0.1
;
;  АВТОРЫ:      Пользователь + ChatGPT
;
;  НАЗНАЧЕНИЕ:
;
;  Данный файл содержит ВСЕ глобальные настройки проекта.
;
;  ВАЖНО!
;
;  Любые строки, числа, имена слоёв, размеры текста,
;  цвета, коэффициенты округления и прочие параметры
;  должны храниться ТОЛЬКО ЗДЕСЬ.
;
;  Остальные модули НЕ ДОЛЖНЫ содержать "магических"
;  чисел и строк.
;
;=====================================================================



;=====================================================================
;                           ВЕРСИЯ ПРОЕКТА
;=====================================================================

(setq *LEP-Version* "0.1")



;=====================================================================
;                           НАСТРОЙКИ ПРОЕКТА
;=====================================================================

(setq *LEP-ProjectName* "LEP")



;=====================================================================
;                           СЛОИ
;=====================================================================

;; Подложка

(setq *LEP-Layer-Kadastr*       "LEP-KADASTR")


;; Воздушные линии

(setq *LEP-Layer-Proj-VL*       "LEP-PROJ-VL")
(setq *LEP-Layer-Exist-VL*      "LEP-EXIST-VL")


;; Кабельные линии

(setq *LEP-Layer-Proj-KL*       "LEP-PROJ-KL")
(setq *LEP-Layer-Exist-KL*      "LEP-EXIST-KL")


;; Опоры

(setq *LEP-Layer-Proj-Pole*     "LEP-PROJ-POLES")
(setq *LEP-Layer-Exist-Pole*    "LEP-EXIST-POLES")


;; Подстанции

(setq *LEP-Layer-Proj-MTP*      "LEP-PROJ-MTP")
(setq *LEP-Layer-Proj-RLK*      "LEP-PROJ-RLK")
(setq *LEP-Layer-Exist-TP*      "LEP-EXIST-TP")
(setq *LEP-Layer-Proj-TP*       "LEP-PROJ-TP")


;; Текст

(setq *LEP-Layer-Text*          "LEP-TEXT")
(setq *LEP-LeaderOffset* 5.0)   ; метров (после калибровки 1 ед. = 1 м), можно потом подвинуть под глаз


;; Размеры

(setq *LEP-Layer-Dim*           "LEP-DIM")



;=====================================================================
;                           ЦВЕТА СЛОЁВ
;=====================================================================
;
; Используются стандартные ACI цвета AutoCAD.
;
; При необходимости можно изменить здесь, не меняя код.
;
;=====================================================================

(setq *LEP-Color-Proj*          1)      ; Красный
(setq *LEP-Color-Exist*         8)      ; Серый
(setq *LEP-Color-Text*          7)      ; Белый
(setq *LEP-Color-Dim*           2)      ; Желтый
(setq *LEP-Color-Kadastr*       9)



;=====================================================================
;                     ВЫСОТЫ ТЕКСТА
;=====================================================================

(setq *LEP-TextHeight*          2.5)



;=====================================================================
;                  ОКРУГЛЕНИЕ ДЛИН
;=====================================================================
;
; Пока принято округлять до 5 метров.
;
; При необходимости изменить только здесь.
;
;=====================================================================

(setq *LEP-LengthRound*         5.0)



;=====================================================================
;                НАСТРОЙКИ ПОДПИСЕЙ ПРОЛЁТОВ
;=====================================================================

(setq *LEP-SpanTextOffset*      3.0)

(setq *LEP-SpanTextRotation*    0)



;=====================================================================
;                  ФАЙЛЫ СПРАВОЧНИКОВ
;=====================================================================

(setq *LEP-MaterialsFile* "materials.csv")



;=====================================================================
;                      ИМЕНА БЛОКОВ
;=====================================================================

;
; ВНИМАНИЕ!
;
; Пока здесь временные значения.
;
; После того как изучим библиотеку блоков,
; заменим их на реальные.
;
;

(setq *LEP-Block-Pole*          "test-block")
(setq *LEP-Block-MTP*           "MTP160")
(setq *LEP-Block-RLK*           "RLK")



;=====================================================================
;                НАСТРОЙКИ КАЛИБРОВКИ
;=====================================================================

(setq *LEP-ReferenceLengths*
      '(10.0 20.0 50.0 100.0))

;=====================================================================
;                 СПИСОК ТИПОВ ОПОР
;
; Используется:
; - выбор пользователем;
; - подписи;
; - ведомость.
;
; Первый элемент:
; отображаемое название.
;
; Второй элемент:
; условный код для учета.
;
;=====================================================================


(setq *LEP-PoleTypes*

    '(

        ("П23"       . "П23")

        ("УП23"      . "УП23")

        ("А23"       . "А23")

        ("УА23"      . "УА23")

        ("УП21"      . "УП21")

        ("К21"       . "К21")

        ("П20-3Н"    . "П20-3Н")

        ("А20-3Н"    . "А20-3Н")

        ("УА20-3Н"   . "УА20-3Н")

        ("УП20-3Н"   . "УП20-3Н")

    )

)
;=====================================================================
;                 СПИСОК ТИПОВ МАТЕРИАЛОВ
;
;
;=====================================================================


(setq *LEP-UseDCL* T)   ; T = диалог со списком (мышкой), nil = ввод номером в консоли

(setq *LEP-WireTypes-VL*
    (list
        (cons "СИП-2 95 мм2" "95")
        (cons "СИП-2 70 мм2" "70")
    )
)

(setq *LEP-WireTypes-KL*
    (list
        (cons "Кабель (марка неизв.) 120 мм2" "120")
    )
)


;=====================================================================
;                 СЛУЖЕБНЫЕ ПЕРЕМЕННЫЕ
;=====================================================================

(setq *LEP-CurrentRoute* nil)

(setq *LEP-CurrentScale* 1.0)



(princ
  (strcat
    "\n"
    "=========================================\n"
    " LEP CONFIG "
    *LEP-Version*
    " загружен.\n"
    "========================================="
  )
)

(princ)