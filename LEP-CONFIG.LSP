;=====================================================================
;                 ОКОНЕЧНОЕ ОБОРУДОВАНИЕ МАРШРУТА (LEP-END)
;=====================================================================
;
; Конец трассы ЛЭП оформляется по-разному в зависимости от класса
; напряжения (см. присланные пользователем скриншоты реальных
; чертежей, 2026-07-10):
;   10 кВ (крупный заявитель)  -> 3 опоры типа *LEP-End-PoleType*
;       подряд (шаг *LEP-End-MTP-Spacing1*/-Spacing2*), 1-я с подписью
;       РЛК, 2-я - МТП, 3-я - ЩУ;
;   0,4 кВ (мелкий заявитель)  -> 1 опора типа *LEP-End-PoleType-PU*
;       (⚠️ 2026-08-03 - СВОЙ тип, "П23", см. константу ниже) с
;       подписью ПУ.
; РЛК/МТП/ЩУ/ПУ - НЕ отдельная графика на чертеже, только текстовые
; подписи рядом с соответствующей опорой (подтверждено пользователем).
;
;=====================================================================

(setq *LEP-End-PoleType*        "П20-3Н")

;; ⚠️ ДОБАВЛЕНО 2026-08-03 (прямое указание пользователя): у окончания
;; "ПУ" опора теперь ДРУГОГО типа - П23, а не общий *LEP-End-PoleType*.
;;
;; Почему ОТДЕЛЬНАЯ константа, а не просто правка *LEP-End-PoleType*
;; выше: та одна константа обслуживает СРАЗУ ВСЁ оконечное
;; оборудование - и ПУ, и СТП, и все три опоры МТП (РЛК/МТП/ЩУ).
;; Пользователь просил поменять тип именно у ПУ, поэтому менять общую
;; константу нельзя - молча переехали бы и МТП со СТП, а на чертеже
;; это выглядело бы как "программа сама себе что-то напридумывала".
;;
;; Если окажется, что П23 нужен и остальным окончаниям - достаточно
;; поставить "П23" в *LEP-End-PoleType* выше, эта строка тогда просто
;; продублирует его, ничего не сломав.
;;
;; ⚠️ Тип ОБЯЗАН присутствовать в двух списках выше, иначе:
;;   *LEP-PoleStands* - и марка стойки для ведомости, и число трапеций
;;       для чертежа. Нет типа -> в CSV громкая строка "НЕТ В
;;       СПРАВОЧНИКЕ СТОЕК" вместо материала (ЭТАП 2, LEP-REPORT.LSP);
;;   *LEP-PoleTypes*  - без него тип нельзя выбрать при обычной
;;       расстановке опор (LEP-POLE.LSP).
;; Проверено на 2026-08-03: "П23" есть в обоих. В *LEP-PoleStands* - со
;; значением ("СВ-95-3" 1): одна стойка, то есть одна трапеция, как и у
;; "П20-3Н", геометрия символа не меняется; в ведомость от опоры ПУ
;; пойдёт строка "Стойка СВ-95-3".
(setq *LEP-End-PoleType-PU*     "П23")

(setq *LEP-End-MTP-Spacing1*    3.0)    ; м, опора1 (РЛК) -> опора2 (МТП)
(setq *LEP-End-MTP-Spacing2*    2.0)    ; м, опора2 (МТП) -> опора3 (ЩУ)

(setq *LEP-Label-RLK*           "РЛК")

;; *LEP-Label-MTP* - ⚠️ ФИКС 2026-07-16: оставлена как ЗНАЧЕНИЕ ПО
;; УМОЛЧАНИЮ/для ОБРАТНОЙ СОВМЕСТИМОСТИ со старыми МТП, поставленными
;; ДО того, как появился выбор мощности (у них в XDATA записан просто
;; общий код "MTP", без указания мощности - см. LEP:GetEquipLabel,
;; LEP-REPORT.LSP). Формат переведён на "мощность/ВН/НН" (160 кВА,
;; 10 кВ высокая сторона, 0,4 кВ низкая) - тот же стандарт, что и у
;; новой строки "МТП-250/10/0,4" ниже, было "МТП-160 кВА" (только
;; мощность, без классов напряжения).
(setq *LEP-Label-MTP*           "МТП-160/10/0,4")

;; Список выбора мощности МТП (2026-07-16, по просьбе пользователя -
;; "МТП-250/10/0,4" тоже встречается у заявителей, не только 160).
;; Для НОВЫХ МТП выбранная строка целиком уходит в XDATA как EQUIP
;; (LEP-END.LSP) - в отличие от старого поведения (*LEP-Label-MTP*
;; выше), название конкретного МТП теперь не "вычисляется заново" из
;; конфига при каждой генерации ведомости, а хранится в самой опоре -
;; иначе разные по мощности МТП было бы не отличить друг от друга в
;; ведомости (обе показывали бы одно и то же название из конфига).
;;
;; ✅ ДОБАВЛЕНО 2026-07-24 (по просьбе пользователя): МТП на 6 кВ - те
;; же мощности (160/250), отличается только средняя часть строки
;; "мощность/ВН/НН": высокая сторона 6 кВ вместо 10 кВ. Больше НИЧЕГО
;; для 6 кВ менять не пришлось - геометрия блока МТП (3 опоры, шаг
;; 3 м/2 м), подписи РЛК/ЩУ, углы разведения подписей и слой опор от
;; класса напряжения не зависят.
;;
;; ⚠️ Список СОЗНАТЕЛЬНО НЕ фильтруется по классу маршрута (решение
;; пользователя 2026-07-24): программа знает VCLASS маршрута и МОГЛА БЫ
;; показывать только подходящие два пункта, но пользователь выбрал
;; видеть все четыре - на случай, если понадобится поставить МТП не того
;; класса, что у маршрута. То есть ответственность за выбор строки -
;; на пользователе, программа тут не подстраховывает.
(setq *LEP-MTP-Types*
    '(
        ("МТП-160/10/0,4" . "МТП-160/10/0,4")
        ("МТП-250/10/0,4" . "МТП-250/10/0,4")
        ("МТП-160/6/0,4"  . "МТП-160/6/0,4")
        ("МТП-250/6/0,4"  . "МТП-250/6/0,4")
    )
)

(setq *LEP-Label-SchU*          "ЩУ")
(setq *LEP-Label-PU*            "ПУ")

;; ✅ ДОБАВЛЕНО 2026-07-22 (по просьбе пользователя): СТП - трансформатор
;; на ОДНОЙ опоре (не путать с МТП - 3 опоры). Пока БЕЗ отдельной
;; графики (маленький квадратик сбоку - отложено, "давай пока текстом"):
;; ставится одна опора (тот же механизм, что у ПУ), подпись как у
;; обычной опоры первой строкой + вторая строка "+ СТП-XX кВА"
;; (LEP:CreatePoleLabel, ClassLabel-параметр). В отличие от
;; *LEP-MTP-Types* - БЕЗ классов напряжения в строке (пользователь
;; явно попросил именно такой, более простой формат для СТП).
(setq *LEP-STP-Types*
    '(
        ("СТП-25 кВА" . "СТП-25 кВА")
        ("СТП-40 кВА" . "СТП-40 кВА")
        ("СТП-63 кВА" . "СТП-63 кВА")
    )
)

;; ✅ ДОБАВЛЕНО 2026-07-22 (по просьбе пользователя): КТП - наземная
;; трансформаторная подстанция (НЕ на опоре, в отличие от МТП/СТП).
;; Номер/мощность/марка - СВОБОДНЫЙ ввод (пользователь: "нет живых
;; примеров из жизни чтоб допилить" список), поэтому фиксированного
;; списка здесь, в отличие от *LEP-MTP-Types*/*LEP-STP-Types*, нет -
;; см. LEP:GetString-запросы в LEP-END.LSP.
;;
;; Графика (прямоугольник + треугольник-значок трансформатора) - на
;; уже существующих, ранее НЕ использовавшихся слоях подстанций
;; (*LEP-Layer-Proj-TP*/*LEP-Layer-Exist-TP*, были заведены давно, но
;; простаивали - МТП/РЛК/ЩУ/ПУ оказались текстом без графики, а КТП
;; наконец даёт им применение).
;;
;; Размер прямоугольника - 3х5 м, ПРИКИДКА пользователя ("дальше
;; допилим", т.е. не финальное значение). Треугольник - ЗАЛИВКА ОДНИМ
;; ЦВЕТОМ (SOLID), БЕЗ градиента (пользователь явно попросил градиент
;; пока не делать) - цвет треугольника ФИКСИРОВАННЫЙ (не зависит от
;; статуса Проект/Сущ), тот же принцип, что и у серого креста в
;; символе опоры (*LEP-Color-PoleCross*).
(setq *LEP-KTP-Width*          3.0)  ; м
(setq *LEP-KTP-Height*         5.0)  ; м
(setq *LEP-Color-KTP-Symbol*   1)    ; Красный (ACI) - треугольник-значок трансформатора

;; ✅ ДОБАВЛЕНО 2026-07-24: ВЫСОКАЯ СТОРОНА КТП спрашивается отдельно.
;;
;; ⚠️ Это ФИКС, а не новая хотелка. Вторая строка подписи КТП имеет
;; формат "мощность/ВН/НН", и класс высокой стороны раньше брался ИЗ
;; КЛАССА МАРШРУТА, на котором стоит КТП. Пока КТП ставили на 10-кВ
;; трассу, это случайно совпадало. Но КТП - это ГРАНИЦА двух классов:
;; на входе 10 или 6 кВ, на выходе 0,4 кВ, и трасса от КТП к заявителю
;; вполне может быть 0,4 кВ (реальный случай пользователя 2026-07-24:
;; КТП -> два кабеля 0,4 кВ -> кабельный киоск). На такой трассе старая
;; логика давала в подписи мусор "160/04/0,4 кВ" - и код класса вместо
;; человекочитаемого "0,4", и логически неверно: высокая сторона к
;; классу ЭТОЙ трассы отношения не имеет.
(setq *LEP-KTP-HighSide*
    '(
        ("10 кВ" . "10")
        ("6 кВ"  . "6")
    )
)


;=====================================================================
;    КК - КАБЕЛЬНЫЙ КИОСК (LEP-KKSYM.LSP / LEP-END.LSP) - 2026-07-24
;=====================================================================
;
; ✅ ДОБАВЛЕНО 2026-07-24 по реальному случаю пользователя: из КТП
; выходят два кабеля 0,4 кВ и идут к заявителю, где НЕТ ни опор, ни
; МТП - стоит просто кабельный киоск, а в нём приборы учёта (в том
; случае - два). До этого дня в проекте не было ни киоска, ни вообще
; возможности закончить кабель чем-то, кроме опоры.
;
; Устроен по образцу КТП (LEP-KTPSYM.LSP): блок-символ, создаваемый
; ОДИН раз через entmake, ставится кликом рядом с трассой (проекция +
; новая вершина + GEOMCONSTRAINT - ровно как опора и КТП), своя XDATA
; (TYPE = "KK"), своя строка в ведомости.
;
; Графика - ПРОСТОЙ ПРЯМОУГОЛЬНИК, БЕЗ значка внутри (решение
; пользователя 2026-07-24: у КТП внутри треугольник-трансформатор,
; потому что там трансформатор и есть; в киоске трансформатора нет,
; рисовать внутри нечего).
;
; ⚠️ Размер 1х2 м - ПРИКИДКА, ровно как было с КТП ("дальше допилим").
; Не финальное значение, менять здесь.
;
; Слой - те же *LEP-Layer-Proj-TP*/*LEP-Layer-Exist-TP*, что и у КТП:
; отдельный слой заводить не стали, т.к. ведомость и так различает
; КТП и КК по ключу TYPE в XDATA, а не по слою (см. ЭТАП 2.6 в
; LEP-REPORT.LSP - проверка TYPE там была с самого начала).
;
; Приборы учёта (ПУ) в киоске - СЧЁТЧИК, а не отдельные объекты:
; спрашивается их количество, оно пишется в XDATA киоска (ключ
; PUCOUNT) и попадает в ведомость отдельной строкой "ПУ" в штуках.
; Заводить на каждый ПУ отдельный объект смысла нет - внутри киоска
; они ничем на плане не отличаются друг от друга.
;
;=====================================================================

(setq *LEP-KK-Width*           1.0)  ; м, ПРИКИДКА - уточнить по факту
(setq *LEP-KK-Height*          2.0)  ; м, ПРИКИДКА - уточнить по факту
(setq *LEP-Label-KK*           "КК") ; первая строка подписи киоска
(setq *LEP-Report-Label-KK*    "Кабельный киоск")  ; название строки в ведомости


;=====================================================================
;   ТОЧКА СМЕНЫ СПОСОБА ПРОКЛАДКИ (LEP-TRANSSYM.LSP) - 2026-07-24
;=====================================================================
;
; ✅ ДОБАВЛЕНО 2026-07-24 по реальному случаю: трасса идёт от КТП под
; углом 90°, первый участок надо пройти ГНБ (проколом), второй -
; обычной траншеей. Способ прокладки (*LEP-Layer-Proj-KL-GNB*/
; *-Trench*) спрашивается ОДИН РАЗ НА ПРОЛЁТ, а пролёт задаётся ДВУМЯ
; ОБЪЕКТАМИ - значит, чтобы поделить кабельный участок надвое, в точке
; перехода должен стоять какой-то объект. Опоры там нет и быть не
; должно (её посчитала бы ведомость), КТП/киоск - тем более.
;
; Отсюда - маркер: пустышка без всякого смысла для сметы, нужная
; ТОЛЬКО для того, чтобы за неё можно было "зацепить" конец пролёта.
; Ставится на трассу тем же механизмом, что КТП и киоск (проекция
; клика + вершина + GEOMCONSTRAINT), и дальше чертятся два обычных
; пролёта: КТП -> маркер (ГНБ), маркер -> киоск (траншея).
;
; ⚠️ СЛОЙ НЕПЕЧАТАЕМЫЙ (прямое требование пользователя: "кружок не
; выводится на печать или PDF") - тот же приём, что у служебной линии
; маршрута и у GPS-кружков: LEP:SetLayerNoPlot в LEP-SETUP.LSP. Это
; рабочая пометка для черчения, а не элемент готового чертежа. На
; готовом плане переход и так виден: участки ГНБ и траншеи лежат на
; РАЗНЫХ слоях с разными цветами.
;
; ⚠️ Подписи у маркера НЕТ СОЗНАТЕЛЬНО. Подпись рисуется на печатаемом
; текстовом слое и полезла бы в PDF - ровно то, чего просили избежать,
; и при этом она ничего не добавляет: где кончается прокол, видно по
; смене цвета линии.
;
; ⚠️ В ВЕДОМОСТИ НЕ УЧИТЫВАЕТСЯ (решение пользователя) - это не
; материал, а граница двух видов работ, кабель в этой точке не
; разрезается, покупать нечего. Отдельных действий для этого не
; потребовалось: ведомость сканирует конкретные слои, а этого слоя в
; её списках просто нет.
;
; ⚠️ Запас кабеля у такого конца - НОЛЬ (кабель тут не заканчивается,
; концевой заделки нет), см. LEP:GetOneEndReserve в LEP-SPAN.LSP:
; тип "TRANS" внесён в "наземный" список ЯВНО, иначе маркер молча
; получил бы 3 м как опора.
;
;=====================================================================

(setq *LEP-Layer-Transition*   "LEP-TRANSITION")
(setq *LEP-Color-Transition*   6)     ; Пурпурный (ACI) - не совпадает с зелёными GPS-кружками
(setq *LEP-Trans-Diameter*     0.5)   ; м, диаметр кружка-маркера

;; Направление смещения подписи (угол в РАДИАНАХ, 0 = вправо, против
;; часовой стрелки) - у обычной опоры всегда 45° (вверх-вправо, как
;; было и раньше). У блока МТП три опоры стоят близко друг к другу
;; (шаг 3м/2м) - если все три подписи пустить в одну и ту же сторону,
;; они накладываются друг на друга (реальная проблема, замечена
;; пользователем 2026-07-10) - поэтому у LEP-END каждая из трёх
;; подписей уходит в СВОЮ сторону (веером), см. LEP-END.LSP.
(setq *LEP-Label-Angle-Default* (/ pi 4.0))          ; 45°, вверх-вправо (обычные опоры)
(setq *LEP-End-LabelAngle-RLK*  (* 0.75 pi))         ; 135°, вверх-влево
(setq *LEP-End-LabelAngle-MTP*  (/ pi 2.0))          ; 90°, прямо вверх
(setq *LEP-End-LabelAngle-SchU* (/ pi 4.0))          ; 45°, вверх-вправо


;=====================================================================
;         GPS-ТОЧКИ ИЗ GEOJSON (LEP-GEOPOINTS.LSP) - 2026-07-20
;=====================================================================
;
; Пользователь снимает GPS-координаты опор в поле (экспорт в GeoJSON,
; WGS84 - широта/долгота), затем нужно поставить на чертёж временные
; зелёные кружки-ориентиры в ТЕХ ЖЕ координатах, что и подоснова
; (МСК-47), чтобы рядом с ними вручную расставить настоящие символы
; опор (Сущ.). Кружки - НЕ часть постоянного чертежа, только рабочий
; ориентир, поэтому отдельный непечатаемый слой (как *LEP-Layer-Route*)
; и отдельная команда его полной очистки.
;
; ⚠️ ВАЖНО - перевод координат WGS84 -> МСК-47 делается НЕ в LISP:
; своя формула (черновая полиномиальная регрессия по 25 калибровочным
; точкам одного участка) была отвергнута - у каждой зоны МСК-47 своё
; смещение и своя нелинейность, локальная подгонка не переживает
; переезд на другой участок (см. LEP-README.md, раздел про GPS-точки,
; полная история). Вместо этого пользователь считает координаты САМ
; через сайт-конвертер (подтверждён рабочим, там указан официальный
; код EPSG:6334702 - МСК-47 зона 2 Ленинградская область, не
; самодельное приближение) - LISP только читает готовый результат.
;
; *LEP-GeoPoints-Diameter* - диаметр кружка (по просьбе пользователя,
; "просто точки", 1 метр - достаточно заметно на плане, но не мешает
; рядом расставлять настоящие опоры).
;
; *LEP-GeoPoints-LabelOffset* - на сколько метров вправо от ЦЕНТРА
; кружка ставится подпись (название точки из GeoJSON) - чуть больше
; радиуса кружка (0.5 м), чтобы подпись не наезжала на сам кружок.
;
;=====================================================================

(setq *LEP-Layer-GeoPoints*         "LEP-GEOPOINTS")
(setq *LEP-Color-GeoPoints*         3)      ; Зелёный (ACI)
(setq *LEP-GeoPoints-Diameter*      1.0)    ; м
(setq *LEP-GeoPoints-LabelOffset*   0.8)    ; м, от центра кружка вправо



(princ
  (strcat
    "\n"
    "=========================================\n"
    " LEP CONFIG "
    *LEP-Version*
    " загружен.\n"
    "========================================="
  )
)

(princ)