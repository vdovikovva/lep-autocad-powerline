(setq *LEP-UseDCL* nil) ; T = диалог со списком (мышкой), nil = ввод номером в консоли - быстрее, по опыту использования


;=====================================================================
;             КЛАСС НАПРЯЖЕНИЯ МАРШРУТА (LEP-ROUTE)
;=====================================================================
;
; Выбирается ОДИН РАЗ при построении маршрута (LEP-ROUTE), а не на
; каждом пролёте - в жизни напряжение не меняется посреди трассы:
; между 10кВ и 0,4кВ участками всегда стоит трансформатор (МТП), а
; значит с точки зрения этой программы это уже НОВЫЙ маршрут (см.
; переписку с пользователем, 2026-07-10). Класс маршрута хранится в
; его XDATA (ключ VCLASS, LEP-DATA.LSP) и дальше используется:
;   - LEP-SPAN выбирает список марок провода по классу маршрута
;     (*LEP-WireTypes-VL-10* для 10кВ, *LEP-WireTypes-VL-04* для
;     0,4кВ - СИП-3 бывает ТОЛЬКО для высокого напряжения (магистраль),
;     СИП-2 ТОЛЬКО для низкого 0,6-1кВ - это разные провода физически,
;     предлагать не тот список для не того класса нельзя);
;   - LEP-POLE берёт отсюда вторую строку подписи опоры
;     ("ВЛЗ-10 кВ" / "ВЛИ-0,4 кВ", *LEP-VoltageClassLabel* ниже).
;
;=====================================================================

(setq *LEP-VoltageClasses*
    '(
        ("10 кВ"  . "10")
        ("0,4 кВ" . "04")
    )
)

(setq *LEP-VoltageClassLabel*
    '(
        ("10" . "ВЛЗ-10 кВ")
        ("04" . "ВЛИ-0,4 кВ")
    )
)

(setq *LEP-WireTypes-VL-10*
    (list
        (cons "СИП-3 3х(1х70 мм2)" "70")
        (cons "СИП-3 3х(1х95 мм2)" "95")
    )
)

(setq *LEP-WireTypes-VL-04*
    (list
        (cons "СИП-2 3х95+1х95 мм2" "95")
        (cons "СИП-2 3х70+1х70 мм2" "70")
    )
)

(setq *LEP-WireTypes-KL*
    (list
        (cons "Кабель (марка неизв.) 120 мм2" "120")
    )
)



;=====================================================================
;                 ОКОНЕЧНОЕ ОБОРУДОВАНИЕ МАРШРУТА (LEP-END)
;=====================================================================
;
; Конец трассы ЛЭП оформляется по-разному в зависимости от класса
; напряжения (см. присланные пользователем скриншоты реальных
; чертежей, 2026-07-10):
;   10 кВ (крупный заявитель)  -> 3 опоры типа *LEP-End-PoleType*
;       подряд (шаг *LEP-End-MTP-Spacing1*/-Spacing2*), 1-я с подписью
;       РЛК, 2-я - МТП, 3-я - ЩУ;
;   0,4 кВ (мелкий заявитель)  -> 1 опора типа *LEP-End-PoleType* с
;       подписью ПУ.
; РЛК/МТП/ЩУ/ПУ - НЕ отдельная графика на чертеже, только текстовые
; подписи рядом с соответствующей опорой (подтверждено пользователем).
;
;=====================================================================

(setq *LEP-End-PoleType*        "П20-3Н")
(setq *LEP-End-MTP-Spacing1*    3.0)    ; м, опора1 (РЛК) -> опора2 (МТП)
(setq *LEP-End-MTP-Spacing2*    2.0)    ; м, опора2 (МТП) -> опора3 (ЩУ)

(setq *LEP-Label-RLK*           "РЛК")
(setq *LEP-Label-MTP*           "МТП-160 кВА")
(setq *LEP-Label-SchU*          "ЩУ")
(setq *LEP-Label-PU*            "ПУ")

;; Направление смещения подписи (угол в РАДИАНАХ, 0 = вправо, против
;; часовой стрелки) - у обычной опоры всегда 45° (вверх-вправо, как
;; было и раньше). У блока МТП три опоры стоят близко друг к другу
;; (шаг 3м/2м) - если все три подписи пустить в одну и ту же сторону,
;; они накладываются друг на друга (реальная проблема, замечена
;; пользователем 2026-07-10) - поэтому у LEP-END каждая из трёх
;; подписей уходит в СВОЮ сторону (веером), см. LEP-END.LSP.
(setq *LEP-Label-Angle-Default* (/ pi 4.0))          ; 45°, вверх-вправо (обычные опоры)
(setq *LEP-End-LabelAngle-RLK*  (* 0.75 pi))         ; 135°, вверх-влево
(setq *LEP-End-LabelAngle-MTP*  (/ pi 2.0))          ; 90°, прямо вверх
(setq *LEP-End-LabelAngle-SchU* (/ pi 4.0))          ; 45°, вверх-вправо


(princ
  (strcat
    "\n"
    "=========================================\n"
    " LEP CONFIG "
    *LEP-Version*
    " загружен.\n"
    "========================================="
  )
)

(princ)