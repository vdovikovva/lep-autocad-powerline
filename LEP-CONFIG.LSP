(setq *LEP-UseDCL* nil) ; T = диалог со списком (мышкой), nil = ввод номером в консоли - быстрее, по опыту использования


;=====================================================================
;             КЛАСС НАПРЯЖЕНИЯ МАРШРУТА (LEP-ROUTE)
;=====================================================================
;
; Выбирается ОДИН РАЗ при построении маршрута (LEP-ROUTE), а не на
; каждом пролёте - в жизни напряжение не меняется посреди трассы:
; между 10кВ и 0,4кВ участками всегда стоит трансформатор (МТП), а
; значит с точки зрения этой программы это уже НОВЫЙ маршрут (см.
; переписку с пользователем, 2026-07-10). Класс маршрута хранится в
; его XDATA (ключ VCLASS, LEP-DATA.LSP) и дальше используется:
;   - LEP-SPAN выбирает список марок провода по классу маршрута
;     (*LEP-WireTypes-VL-10* для 10кВ, *LEP-WireTypes-VL-04* для
;     0,4кВ - СИП-3 бывает ТОЛЬКО для высокого напряжения (магистраль),
;     СИП-2 ТОЛЬКО для низкого 0,6-1кВ - это разные провода физически,
;     предлагать не тот список для не того класса нельзя);
;   - LEP-POLE берёт отсюда вторую строку подписи опоры
;     ("ВЛЗ-10 кВ" / "ВЛИ-0,4 кВ", *LEP-VoltageClassLabel* ниже).
;
;=====================================================================

;; ✅ ДОБАВЛЕНО 2026-07-22 (по просьбе пользователя): третий класс
;; напряжения - "6 кВ". Цвет слоя/опор у 6кВ ПОКА СОЗНАТЕЛЬНО НЕ свой -
;; переиспользует те же 2 слоя, что и 10кВ (LEP-SPAN.LSP/LEP-POLE.LSP -
;; их ветка "если статус/класс не 0,4кВ" уже трактует "6" точно так же,
;; как "10", отдельного слоя заводить не пришлось). Пользователь прямо
;; сказал "дальше видно будет" - если позже понадобится отличать 6кВ
;; от 10кВ цветом, придётся завести *LEP-Layer-Proj-VL-6*/*-Pole-6* по
;; тому же образцу, что и *-04* (см. раздел "СЛОИ" выше).
(setq *LEP-VoltageClasses*
    '(
        ("10 кВ"  . "10")
        ("6 кВ"   . "6")
        ("0,4 кВ" . "04")
    )
)

(setq *LEP-VoltageClassLabel*
    '(
        ("10" . "ВЛЗ-10 кВ")
        ("6"  . "ВЛЗ-6 кВ")
        ("04" . "ВЛИ-0,4 кВ")
    )
)

(setq *LEP-WireTypes-VL-10*
    (list
        (cons "СИП-3 3х(1х70 мм2)" "70")
        (cons "СИП-3 3х(1х95 мм2)" "95")
    )
)

;; ⚠️ ОТКРЫТЫЙ ВОПРОС (как и у *LEP-WireTypes-VL-10* выше - см.
;; "Известные открытые проблемы" в LEP-README.md): марки временно
;; СКОПИРОВАНЫ с 10кВ-списка "на правдоподобный вид" - СИП-3
;; действительно применяется и на 6кВ ЛЭП, но КОНКРЕТНЫЕ сечения/марки
;; для 6кВ пользователь не прислал. Поправить эту строку, как только
;; будут точные марки - остальной код (LEP-SPAN.LSP) их не хардкодит,
;; список подтягивается отсюда автоматически.
(setq *LEP-WireTypes-VL-6*
    (list
        (cons "СИП-3 3х(1х70 мм2)" "70")
        (cons "СИП-3 3х(1х95 мм2)" "95")
    )
)

(setq *LEP-WireTypes-VL-04*
    (list
        (cons "СИП-2 3х95+1х95 мм2" "95")
        (cons "СИП-2 3х70+1х70 мм2" "70")
    )
)

