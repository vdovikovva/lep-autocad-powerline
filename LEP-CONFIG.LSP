;; переиспользует те же 2 слоя, что и 10кВ (LEP-SPAN.LSP/LEP-POLE.LSP -
;; их ветка "если статус/класс не 0,4кВ" уже трактует "6" точно так же,
;; как "10", отдельного слоя заводить не пришлось). Пользователь прямо
;; сказал "дальше видно будет" - если позже понадобится отличать 6кВ
;; от 10кВ цветом, придётся завести *LEP-Layer-Proj-VL-6*/*-Pole-6* по
;; тому же образцу, что и *-04* (см. раздел "СЛОИ" выше).
(setq *LEP-VoltageClasses*
    '(
        ("10 кВ"  . "10")
        ("6 кВ"   . "6")
        ("0,4 кВ" . "04")
    )
)

(setq *LEP-VoltageClassLabel*
    '(
