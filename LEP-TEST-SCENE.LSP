;=====================================================================
;
;   ПРОЕКТ:      LEP
;   ФАЙЛ:        LEP-TEST-SCENE.LSP
;   НАЗНАЧЕНИЕ:  ИСПЫТАТЕЛЬНЫЙ СТЕНД, НЕ ЧАСТЬ ПРОГРАММЫ
;
;   ⚠️ ЭТОТ ФАЙЛ НЕ ГРУЗИТСЯ АВТОМАТИЧЕСКИ. В LEP-START.LSP список
;   модулей задан явным перечислением, и этого файла там нет - грузить
;   вручную через APPLOAD, только когда нужен тест.
;
;   ⚠️ ЗАПУСКАТЬ ТОЛЬКО НА ПУСТОМ ЧЕРТЕЖЕ. Скрипт ничего не удаляет и
;   не портит, но строит целую сцену - на боевом чертеже она будет
;   мешаться. Убирать её проще всего закрытием чертежа без сохранения.
;
;=====================================================================
;
;   ЗАЧЕМ ЭТО НУЖНО
;
;   Проверяем параллельный сдвиг проводов на общем участке двух
;   маршрутов. Воспроизвести сценарий руками - это два десятка кликов,
;   и каждый раз чуть по-другому: то вершина ляжет ровно на опору, то
;   мимо. А разница между "ровно" и "мимо" - как раз то, что мы и
;   проверяем, случайной она быть не должна.
;
;   Сцена повторяет реальный чертёж пользователя:
;     - маршрут 1 идёт по существующим опорам до существующей ТП;
;     - маршрут 2 начинается на своей улице, вливается в маршрут 1 и
;       дальше идёт с ним по ОБЩИМ опорам до той же ТП.
;
;   ⚠️ ТРИ ВЕЩИ СДЕЛАНЫ "КРИВО" НАМЕРЕННО - в этом весь смысл теста:
;
;   1. Вершины маршрута 2 на общем участке НЕ ЛЕЖАТ НА ОПОРАХ. Опоры
;      принадлежат маршруту 1, вершины в них вставляла постановка опор;
;      маршрут 2 пользователь рисует руками поверх, и его вершины
;      стоят там, где он кликал. Именно отсюда взялось наблюдение
;      "размеры где-то задвоились, а где-то нет". Нарисуй я сцену
;      аккуратно, вершина в вершину, - тест был бы бесполезен.
;
;   2. Маршрут 2 отстоит от маршрута 1 на 0,2-0,4 м - как рука
;      промахивается на глаз. Это МЕНЬШЕ допуска
;      *LEP-Route-Detect-Tolerance* (1 м), иначе геометрический поиск
;      маршрута не признал бы маршрут 2 проходящим через опоры.
;
;   3. Координаты сцены - БОЛЬШИЕ (около 2 247 000 / 454 600, зона
;      МСК-47, как на реальных чертежах), а не около нуля. На всякий
;      случай: если где-то в расчётах вылезет потеря точности на
;      больших числах, пусть она вылезет в тесте, а не на боевом
;      чертеже.
;
;=====================================================================
;
;   КОМАНДЫ
;
;   LEP-TEST-SCENE        строит сцену (маршруты, опоры, ТП)
;   LEP-TEST-OFFSET-DEMO  рисует ДВА варианта сдвига для сравнения
;   LEP-TEST-CLEAN        стирает только то, что нарисовал DEMO
;
;=====================================================================


;; Базовая точка сцены. Все координаты ниже задаются СМЕЩЕНИЕМ от неё,
;; в метрах - так их видно и можно править, не считая семизначные числа.
(setq *LEP-Test-Base* (list 2247000.0 454600.0))


;=====================================================================
; LEP:TP - точка сцены по смещению от базовой, в метрах
;=====================================================================

(defun LEP:TP (Dx Dy)
    (list
        (+ (car  *LEP-Test-Base*) Dx)
        (+ (cadr *LEP-Test-Base*) Dy)
    )
)


;=====================================================================
; LEP:TestDrawRoute
;
; Рисует полилинию маршрута и вешает на неё XDATA - ровно тем же
; способом, что и C:LEP-ROUTE: команда _.PLINE на служебном слое, потом
; LEP:AddRoute. Через entmake делать НЕ стал специально: чем ближе
; тестовая сцена к настоящему пути создания, тем меньше шансов, что
; тест пройдёт на объектах, которых в реальной работе не бывает.
;
; Возвращает список (ename ID).
;=====================================================================

(defun LEP:TestDrawRoute (Pts VClass / OldLayer Ent ID P)

    (setq OldLayer (getvar "CLAYER"))
    (LEP:SetCurrentLayer *LEP-Layer-Route*)

    (command "_.PLINE")
    (foreach P Pts (command P))
    (command "")

    (setq Ent (entlast))
    (setq ID (LEP:AddRoute Ent VClass))
    (LEP:CreateRouteLabel (car Pts) ID)

    (setvar "CLAYER" OldLayer)

    (list Ent ID)
)


;=====================================================================
; LEP:TestOffsetSubset
;
; ПРОТОТИП будущего сдвига - живёт здесь, а не в LEP-SPAN.LSP, пока не
; посмотрим на результат глазами.
;
; Сдвигает вершины списка начиная с индекса FromIdx на Dist метров по
; НОРМАЛИ К СВОЕМУ ОТРЕЗКУ (у последней вершины - к предыдущему).
; Вершины до FromIdx остаются на месте.
;
; ⚠️ Нормаль СВОЯ У КАЖДОЙ ВЕРШИНЫ - в этом главное отличие от нынешней
; LEP:OffsetPointList, которая берёт ОДИН перпендикуляр к прямой
; "первый конец - последний конец" и двигает по нему всё разом. На
; прямом пролёте разницы нет, а на изогнутом маршруте 2 (своя улица,
; потом поворот на общий участок) один общий перпендикуляр увёл бы
; линию вбок под углом вместо параллельного сдвига.
;
; FromIdx = 0 даёт вариант "сдвинут весь пролёт".
;=====================================================================

(defun LEP:TestOffsetSubset (Pts FromIdx Dist / N i A B Dx Dy L Result Pt)

    (setq N (length Pts))
    (setq i 0)
    (setq Result nil)

    (foreach Pt Pts

        (if (< i FromIdx)

            (setq Result (append Result (list Pt)))

            (progn
                ;; Направление в этой вершине: к следующей, а у самой
                ;; последней - от предыдущей.
                (if (< i (1- N))
                    (progn (setq A Pt) (setq B (nth (1+ i) Pts)))
                    (progn (setq A (nth (1- i) Pts)) (setq B Pt))
                )

                (setq Dx (- (car B) (car A)))
                (setq Dy (- (cadr B) (cadr A)))
                (setq L (distance A B))

                (if (< L 1e-9)
                    (setq Result (append Result (list Pt)))
                    (setq Result
                        (append Result
                            (list
                                (list
                                    (+ (car  Pt) (* (/ (- Dy) L) Dist))
                                    (+ (cadr Pt) (* (/    Dx  L) Dist))
                                )
                            )
                        )
                    )
                )
            )
        )

        (setq i (1+ i))
    )

    Result
)


;=====================================================================
; LEP:TestDemoPline - полилиния заданного цвета на демо-слое
;=====================================================================

(defun LEP:TestDemoPline (Pts ColorNum)
    (entmake
        (append
            (list
                '(0 . "LWPOLYLINE")
                '(100 . "AcDbEntity")
                '(8 . "LEP-TEST-DEMO")
                (cons 62 ColorNum)
                '(100 . "AcDbPolyline")
                (cons 90 (length Pts))
                '(70 . 0)
            )
            (mapcar '(lambda (P) (cons 10 (list (car P) (cadr P)))) Pts)
        )
    )
)


;=====================================================================
; C:LEP-TEST-SCENE
;
; ГЕОМЕТРИЯ СЦЕНЫ (смещения от базовой точки, метры):
;
;   маршрут 1:  (0,0) ─────────────────────────────── (300,0)
;               опоры на 0, 45, 95, 140, 185, 230, 265
;               ТП в конце, на 300
;
;   маршрут 2:  (40,-140) ── (80,-100) ── (120,-60)      своя улица,
;                                              ╲          свои опоры
;                                               ╲
;                              (170, 0.4) ── (235,-0.3) ── (300,0)
;                                     общий участок с маршрутом 1,
;                                     СВОИХ ОПОР ЗДЕСЬ НЕТ
;
; Вершины 170 / 235 стоят МЕЖДУ опорами маршрута 1 (185, 230, 265) и
; отстоят от его линии на 0,4 и 0,3 м - см. пункты 1 и 2 в шапке файла.
;=====================================================================

(defun C:LEP-TEST-SCENE (/ OldOs OldLayer R1 R2 Route1 ID1 Route2 ID2 Dx P
                           VClass ClassLabel TpPt InsertResult Pt1 KtpEnt)

    (LEP:PrintHeader "ТЕСТОВАЯ СЦЕНА: два маршрута с общим участком")

    (setq VClass "10")
    (setq ClassLabel (cdr (assoc VClass *LEP-VoltageClassLabel*)))

    ;; Привязки выключаем на время построения: сцена задаётся точными
    ;; координатами, и притягивание к уже нарисованному нам тут только
    ;; помешает. В конце возвращаем как было.
    (setq OldOs (getvar "OSMODE"))
    (setq OldLayer (getvar "CLAYER"))
    (setvar "OSMODE" 0)

    ;-----------------------------------------------------------------
    ; МАРШРУТ 1 - прямой, с востока на запад
    ;-----------------------------------------------------------------
    (princ "\n[ТЕСТ] Маршрут 1...")
    (setq R1 (LEP:TestDrawRoute (list (LEP:TP 0.0 0.0) (LEP:TP 300.0 0.0)) VClass))
    (setq Route1 (car R1))
    (setq ID1 (cadr R1))

    ;-----------------------------------------------------------------
    ; СУЩЕСТВУЮЩИЕ ОПОРЫ МАРШРУТА 1
    ;
    ; Статус EXIST - сценарий коллеги именно такой: новый провод идёт по
    ; уже стоящим опорам.
    ;-----------------------------------------------------------------
    (princ "\n[ТЕСТ] Опоры маршрута 1...")
    (foreach Dx '(0.0 45.0 95.0 140.0 185.0 230.0 265.0)
        (LEP:PlacePoleOnRoute Route1 ID1 ClassLabel (LEP:TP Dx 0.0) "П23" "EXIST" VClass)
    )

    ;-----------------------------------------------------------------
    ; СУЩЕСТВУЮЩАЯ ТП В КОНЦЕ МАРШРУТА 1
    ;
    ; Повторяет ветку КТП из C:LEP-END: вершина на маршруте, символ,
    ; подпись, XDATA. Значения (номер, мощность, марка) взяты
    ; произвольные - на проверку сдвига они не влияют никак, а высокая
    ; сторона берётся первым пунктом из *LEP-KTP-HighSide*, чтобы не
    ; угадывать её код руками.
    ;
    ; ⚠️ ОДНО ОТЛИЧИЕ ОТ БОЕВОГО C:LEP-END: не накладывается
    ; GEOMCONSTRAINT между символом ТП и вершиной маршрута. Для теста
    ; сдвига это безразлично (связь нужна, чтобы символ ехал за
    ; вершиной при редактировании трассы, а мы её не двигаем), но если
    ; на этой же сцене начнёшь проверять что-то про перемещение
    ; объектов - помни, что связи тут нет.
    ;-----------------------------------------------------------------
    (princ "\n[ТЕСТ] ТП...")
    (setq TpPt (LEP:TP 300.0 0.0))
    (setq InsertResult (LEP:InsertVertexOnRoute Route1 TpPt))
    (setq Pt1 (car InsertResult))
    (setq KtpEnt (LEP:InsertKtpSymbol Pt1 "EXIST"))
    (if KtpEnt
        (progn
            (LEP:CreateKtpLabel Pt1 "EXIST" "5766" 160.0 (cdr (car *LEP-KTP-HighSide*)) "ТМГ-160")
            (LEP:AddKtpData KtpEnt ID1 "EXIST" "5766" 160.0 "ТМГ-160" (cdr (car *LEP-KTP-HighSide*)))
        )
    )

    ;-----------------------------------------------------------------
    ; МАРШРУТ 2 - своя улица, слияние, общий участок до той же ТП
    ;
    ; ⚠️ Последняя вершина - РОВНО точка ТП. Без этого геометрический
    ; поиск маршрута (LEP:FindRoutesThroughPoints) не признал бы
    ; маршрут 2 проходящим через оба конца будущего пролёта, и мы бы
    ; тестировали не то.
    ;-----------------------------------------------------------------
    (princ "\n[ТЕСТ] Маршрут 2...")
    (setq R2
        (LEP:TestDrawRoute
            (list
                (LEP:TP  40.0 -140.0)
                (LEP:TP  80.0 -100.0)
                (LEP:TP 120.0  -60.0)
                (LEP:TP 170.0    0.4)
                (LEP:TP 235.0   -0.3)
                (LEP:TP 300.0    0.0)
            )
            VClass
        )
    )
    (setq Route2 (car R2))
    (setq ID2 (cadr R2))

    ;-----------------------------------------------------------------
    ; ОПОРЫ МАРШРУТА 2 - ТОЛЬКО НА ЕГО СОБСТВЕННОЙ УЛИЦЕ
    ;
    ; ⚠️ На общем участке своих опор у маршрута 2 НЕТ И БЫТЬ НЕ ДОЛЖНО -
    ; там висят провода обоих фидеров на опорах маршрута 1. Поставь я
    ; их сюда "для красоты" - сцена перестала бы воспроизводить задачу.
    ;-----------------------------------------------------------------
    (princ "\n[ТЕСТ] Опоры маршрута 2...")
    (foreach P (list (LEP:TP 40.0 -140.0) (LEP:TP 80.0 -100.0) (LEP:TP 120.0 -60.0))
        (LEP:PlacePoleOnRoute Route2 ID2 ClassLabel P "П23" "EXIST" VClass)
    )

    (setvar "OSMODE" OldOs)
    (setvar "CLAYER" OldLayer)
    (command "_.ZOOM" "_Extents")

    (princ (strcat "\n[ТЕСТ] Готово. Маршрут 1 = " ID1 ", маршрут 2 = " ID2 "."))
    (princ "\n[ТЕСТ] Дальше руками: LEP-SPAN, пролёт маршрута 1 (первая опора -> ТП),")
    (princ "\n[ТЕСТ] потом пролёт маршрута 2 (его первая опора -> та же ТП).")
    (princ "\n[ТЕСТ] Трассы не видно - это норма, слой непечатаемый. Показать: LEP-ROUTEVIS.")
    (princ)
)


;=====================================================================
; C:LEP-TEST-OFFSET-DEMO
;
; Рисует ДВА варианта сдвига маршрута 2 - просто картинку для сравнения
; глазами. Настоящие пролёты не трогает, ничего не считает: где начнётся
; сдвиг, тут задано вручную, а не найдено поиском перекрытия (его ещё
; нет). Задача демо - ответить на ОДИН вопрос: как это выглядит.
;
;   КРАСНЫЙ  - сдвинут ВЕСЬ пролёт маршрута 2, включая свою улицу
;   ЗЕЛЁНЫЙ  - сдвинут только общий участок (с вершины 170)
;
; ⚠️ Смотреть надо на ДВЕ вещи, и вторая важнее первой:
;   1. как выглядит место, где зелёная линия уходит вбок;
;   2. ЧИТАЮТСЯ ЛИ ВООБЩЕ ДВЕ ЛИНИИ при сдвиге 0,3 м на твоём рабочем
;      масштабе печати. Если не читаются - сдвиг бессмысленен, и число
;      надо обсуждать заново, а не писать под него код.
;=====================================================================

(defun C:LEP-TEST-OFFSET-DEMO (/ OldLayer Pts Dist)

    (LEP:PrintHeader "ДЕМО: два варианта параллельного сдвига")

    (setq Dist 0.3)

    (setq Pts
        (list
            (LEP:TP  40.0 -140.0)
            (LEP:TP  80.0 -100.0)
            (LEP:TP 120.0  -60.0)
            (LEP:TP 170.0    0.4)
            (LEP:TP 235.0   -0.3)
            (LEP:TP 300.0    0.0)
        )
    )

    ;; Слой создаём НАШЕЙ ЖЕ LEP:CreateLayer, а не своим вызовом
    ;; команды LAYER: форма вызова там уже проверена и работает, а
    ;; сочинять её заново - лишний способ ошибиться.
    ;; ⚠️ LEP:CreateLayer делает новый слой ТЕКУЩИМ (известная ловушка,
    ;; см. CLAUDE.md) - поэтому CLAYER сохраняем и возвращаем.
    (setq OldLayer (getvar "CLAYER"))
    (LEP:CreateLayer "LEP-TEST-DEMO" 8)
    (setvar "CLAYER" OldLayer)

    ;; Вариант A - сдвиг с самой первой вершины, то есть всё целиком.
    (LEP:TestDemoPline (LEP:TestOffsetSubset Pts 0 Dist) 1)

    ;; Вариант В - сдвиг с вершины 3 (это (170, 0.4), начало общего
    ;; участка). Переход получается сам собой: отрезок от вершины 2 к
    ;; вершине 3 становится чуть наклонным, никакой ступеньки.
    (LEP:TestDemoPline (LEP:TestOffsetSubset Pts 3 Dist) 3)

    (princ (strcat "\n[ДЕМО] Сдвиг " (rtos Dist 2 2) " м. КРАСНЫЙ - весь пролёт, ЗЕЛЁНЫЙ - только общий участок."))
    (princ "\n[ДЕМО] Зумируй на место слияния (примерно середина сцены) и смотри переход.")
    (princ "\n[ДЕМО] Стереть демо-линии: LEP-TEST-CLEAN.")
    (princ)
)


;=====================================================================
; C:LEP-TEST-CLEAN
;
; Стирает ТОЛЬКО объекты демо-слоя LEP-TEST-DEMO. Саму сцену (маршруты,
; опоры, ТП, пролёты) НЕ трогает СОЗНАТЕЛЬНО: команда, которая чистит
; всё подряд по маске "LEP-*", однажды запустится не на том чертеже.
; Сцену убирать закрытием чертежа без сохранения.
;=====================================================================

(defun C:LEP-TEST-CLEAN (/ SS)

    (setq SS (ssget "_X" '((8 . "LEP-TEST-DEMO"))))

    (if SS
        (progn
            (command "_.ERASE" SS "")
            (princ (strcat "\n[ДЕМО] Стёрто объектов: " (itoa (sslength SS))))
        )
        (princ "\n[ДЕМО] На слое LEP-TEST-DEMO ничего нет.")
    )
    (princ)
)


(princ "\nЗагружен ИСПЫТАТЕЛЬНЫЙ СТЕНД. Команды: LEP-TEST-SCENE, LEP-TEST-OFFSET-DEMO, LEP-TEST-CLEAN")
(princ)
