    1: ;=====================================================================
    2: ; ПРОЕКТ:       LEP (Автоматизация проектирования ЛЭП)
    3: ; ФАЙЛ:         LEP-REPORT.LSP
    4: ; ВЕРСИЯ:       0.4
    5: ; НАЗНАЧЕНИЕ:   Полностью автоматический сбор объемов материалов 
    6: ;               (чистые длины линий без округления и штучные опоры) 
    7: ;               с разделением по ID трасс и экспортом в формат CSV.
    8: ;=====================================================================
    9: 
   10: (defun C:LEP-REPORT ( /  ; Список локальных переменных для защиты памяти
   11:                         VL-SS KL-SS PoleSS CsvPath CsvFile i Ent VlaObj 
   12:                         Len Layer Name XData ResID PoleList Item 
   13:                         MasterList RouteID FoundRoute FoundPole 
   14:                         FileCheck )
   15:     
   16:     ; Подключаем базовые функции Visual LISP (ActiveX) для расширенной работы с объектами
   17:     (vl-load-com)
   18:     
   19:     ; Выводим стандартное текстовое приветствие из LEP-UTILS
   20:     (LEP:PrintHeader "Автоматическая выгрузка ведомости в CSV")
   21: 
   22:     ;-----------------------------------------------------------------
   23:     ; СТРУКТУРА ДАННЫХ (MasterList):
   24:     ; Хранит агрегированные данные в виде вложенных списков по каждой трассе:
   25:     ; (
   26:     ;   ("LEP_ROUTE_1" . ( ("LineLen" . 145.62) ("П20-3Н" . 4) ("А23" . 1) ))
   27:     ;   ("LEP_ROUTE_2" . ( ("LineLen" . 89.11)  ("П23" . 3) ))
   28:     ; )
   29:     ;-----------------------------------------------------------------
   30:     (setq MasterList nil)
   31: 
   32:     ;=================================================================
   33:     ; ЭТАП 1: СБОР И ГЕОМЕТРИЧЕСКИЙ РАСЧЕТ ЛИНЕЙНОЙ ЧАСТИ (ВЛ и КЛ)
   34:     ;=================================================================
   35:     
   36:     ; Формируем выборку всех легких полилиний (LWPOLYLINE) на проектных слоях ВЛ и КЛ
   37:     (setq VL-SS (ssget "_X" (list '(0 . "LWPOLYLINE") 
   38:                                   (cons 8 (strcat *LEP-Layer-Proj-VL* "," *LEP-Layer-Proj-KL*)))))
   39: 
   40:     (if VL-SS
   41:         (progn
   42:             (setq i 0)
   43:             ; Цикл перебора всех найденных кабелей и проводов
   44:             (repeat (sslength VL-SS)
   45:                 (setq Ent (ssname VL-SS i))
   46:                 ; Преобразуем стандартный ename во вла-объект для доступа к ActiveX методам
   47:                 (setq VlaObj (vlax-ename->vla-object Ent))
   48:                 
   49:                 ; Извлекаем чистую геометрическую длину объекта (БЕЗ ОКРУГЛЕНИЙ)
   50:                 (setq Len (vla-get-length VlaObj))
   51:                 
   52:                 ; Читаем расширенные данные (XDATA) объекта, привязанные к приложению "LEP_DATA"
   53:                 (setq XData (assoc -3 (entget Ent '("LEP_DATA"))))
   54:                 
   55:                 (if XData
   56:                     ; Если XDATA есть, вытаскиваем сохраненный уникальный ID трассы
   57:                     (setq RouteID (cdr (nth 4 (car (cdr XData)))))
   58:                     ; Если объект лежит на слое, но не размечен кодом — маркируем как потерянный
   59:                     (setq RouteID "НЕРАЗМЕЧЕННЫЕ_ЛИНИИ")
   60:                 )
   61: 
   62:                 ; Ищем, создана ли уже запись для этой трассы в нашем главном списке MasterList
   63:                 (setq FoundRoute (assoc RouteID MasterList))
   64:                 
   65:                 (if FoundRoute
   66:                     ; Если трасса уже есть, извлекаем её текущую длину, прибавляем новую и обновляем список
   67:                     (progn
   68:                         (setq PoleList (cdr FoundRoute))
   69:                         (setq FoundPole (assoc "LineLen" PoleList))
   70:                         (if FoundPole
   71:                             (setq PoleList (subst (cons "LineLen" (+ (cdr FoundPole) Len)) FoundPole PoleList))
   72:                             (setq PoleList (append PoleList (list (cons "LineLen" Len))))
   73:                         )
   74:                         (setq MasterList (subst (cons RouteID PoleList) FoundRoute MasterList))
   75:                     )
   76:                     ; Если трасса встретилась впервые, инициализируем её структуру с начальной длиной
   77:                     (setq MasterList (append MasterList (list (cons RouteID (list (cons "LineLen" Len))))))
   78:                 )
   79:                 (setq i (1+ i))
   80:             )
   81:         )
   82:     )
   83: 
   84:     ;=================================================================
   85:     ; ЭТАП 2: СБОР И АНАЛИЗ ПРОЕКТНЫХ ОПОР (ВКЛЮЧАЯ ДИНАМИЧЕСКИЕ БЛОКИ)
   86:     ;=================================================================
   87:     
   88:     ; Находим абсолютно все вхождения блоков (INSERT) на проектном слое опор
   89:     (setq PoleSS (ssget "_X" (list '(0 . "INSERT") (cons 8 *LEP-Layer-Proj-Pole*))))
   90: 
   91:     (if PoleSS
   92:         (progn
   93:             (setq i 0)
   94:             ; Поштучно перебираем все опоры на чертеже
   95:             (repeat (sslength PoleSS)
   96:                 (setq Ent (ssname PoleSS i))
   97:                 (setq VlaObj (vlax-ename->vla-object Ent))
   98:                 
   99:                 ; РЕШЕНИЕ ПРОБЛЕМЫ ДИНАМИЧЕСКИХ БЛОКОВ:
  100:                 ; vla-get-EffectiveName извлекает ИСХОДНОЕ имя блока из описания, 
  101:                 ; даже если на чертеже конкретный блок стал анонимным (*U...) из-за смены свойств видимости.
  102:                 (setq PoleName (vla-get-EffectiveName VlaObj))
  103:                 
  104:                 ; Считываем XDATA опоры для определения её принадлежности к конкретной линии
  105:                 (setq XData (assoc -3 (entget Ent '("LEP_DATA"))))
  106:                 
  107:                 (if XData
  108:                     (setq RouteID (cdr (nth 4 (car (cdr XData)))))
  109:                     (setq RouteID "ОПОРА_БЕЗ_ТРАССЫ")
  110:                 )
  111: 
  112:                 ; Проверяем наличие этой трассы в MasterList
  113:                 (setq FoundRoute (assoc RouteID MasterList))
  114:                 
  115:                 (if FoundRoute
  116:                     ; Если ветка трассы создана (например, на этапе обсчета линий)
  117:                     (progn
  118:                         (setq PoleList (cdr FoundRoute))
  119:                         ; Ищем конкретный тип опоры (например, "П20-3Н") внутри этой трассы
  120:                         (setq FoundPole (assoc PoleName PoleList))
  121:                         
  122:                         (if FoundPole
  123:                             ; Если тип опоры уже встречался на этой линии — инкрементируем счетчик (+1)
  124:                             (setq PoleList (subst (cons PoleName (1+ (cdr FoundPole))) FoundPole PoleList))
  125:                             ; Если тип опоры на этой линии новый — добавляем со значением 1
  126:                             (setq PoleList (append PoleList (list (cons PoleName 1))))
  127:                         )
  128:                         ; Записываем обновленный подсписок материалов обратно в главную базу данных трассы
  129:                         (setq MasterList (subst (cons RouteID PoleList) FoundRoute MasterList))
  130:                     )
  131:                     ; Если опора стоит изолированно и трассы еще не было в списке — создаем новую ветку
  132:                     (setq MasterList (append MasterList (list (cons RouteID (list (cons PoleName 1))))))
  133:                 )
  134:                 (setq i (1+ i))
  135:             )
  136:         )
  137:     )
  138: 
  139:     ;=================================================================
  140:     ; ЭТАП 3: АВТОМАТИЧЕСКАЯ ЗАПИСЬ ДАННЫХ В ФАЙЛ CSV С ЗАЩИТОЙ ОТ СБОЕВ
  141:     ;=================================================================
  142:     
  143:     ; Автоматически вычисляем путь к целевому CSV файлу в директории текущего DWG
  144:     (setq CsvPath (strcat (getvar "DWGPREFIX") (vl-filename-base (getvar "DWGNAME")) "_ведомость.csv"))
  145:     
  146:     ; ЗАЩИТА ОТ БЛОКИРОВКИ EXCEL:
  147:     ; Пробуем открыть файл в режиме добавления ("a"). Если Excel держит файл, open вернет nil.
  148:     (setq FileCheck (open CsvPath "a"))
  149:     
  150:     (if (not FileCheck)
  151:         ; Если файл заблокирован, прерываем выполнение и выводим громкое предупреждение
  152:         (progn
  153:             (princ "\n!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!")
  154:             (princ (strcat "\n[КРИТИЧЕСКАЯ ОШИБКА]: Файл ведомости заблокирован!"))
  155:             (princ "\nВозможно, этот CSV файл сейчас открыт в Microsoft Excel.")
  156:             (princ "\nПожалуйста, закройте Excel и запустите команду LEP-REPORT снова.")
  157:             (princ "\n!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!")
  158:         )
  159:         (progn
  160:             (close FileCheck) ; Закрываем проверочный дескриптор
  161:             
  162:             ; Открываем файл заново в режиме чистой перезаписи ("w")
  163:             (setq CsvFile (open CsvPath "w"))
  164:             
  165:             ; Записываем стандартную шапку таблицы. 
  166:             ; Разделитель — СТРОГО СЕМИКОЛОН (точка с запятой) для моментального открытия в русском Excel.
  167:             (write-line "Трасса;Наименование материала / оборудования;Количество;Ед. изм." CsvFile)
  168:             
  169:             ; Перебираем сформированную базу данных по всем трассам чертежа
  170:             (foreach RouteItem MasterList
  171:                 (setq ResID (car RouteItem))     ; ID текущей трассы
  172:                 (setq PoleList (cdr RouteItem))   ; Список её элементов
  173:                 
  174:                 ; Сначала выгружаем общую чистую длину кабельных/воздушных трасс
  175:                 (setq FoundPole (assoc "LineLen" PoleList))
  176:                 (if FoundPole
  177:                     (progn
  178:                         ; Для красоты определяем тип проводника по названию ID или слою.
  179:                         ; Выводим REAL-значение длины с точностью до 2 знаков после запятой без искажения округлением
  180:                         (write-line (strcat ResID ";Проводник (проектная длина согласно геометрии);" (rtos (cdr FoundPole) 2 2) ";м.") CsvFile)
  181:                     )
  182:                 )
  183:                 
  184:                 ; Теперь выгружаем все опоры, которые жестко привязаны к этой конкретной трассе
  185:                 (foreach Item PoleList
  186:                     (if (/= (car Item) "LineLen") ; Пропускаем системную переменную длины
  187:                         (write-line (strcat ResID ";Опора проектная типа " (car Item) ";" (itoa (cdr Item)) ";шт.") CsvFile)
  188:                     )
  189:                 )
  190:             )
  191:             
  192:             ; Закрываем файл, освобождая буфер обмена операционной системы
  193:             (close CsvFile)
  194:             
  195:             (princ "\n=======================================================")
  196:             (princ "\n[УСПЕХ] Сквозной сбор объемов завершен без ручного выбора.")
  197:             (princ (strcat "\n Файл сохранен: " CsvPath))
  198:             (princ "\n Данные сгруппированы по ID трасс на основе XDATA.")
  199:             (princ "\n Длины взяты в чистом виде без повторных округлений.")
  200:             (princ "\n=======================================================")
  201:         )
  202:     )
  203:     (LEP:PrintFooter)
  204:     (princ)
  205: )
  206: 
  207: (princ "\nМодуль LEP-REPORT v0.4 успешно интегрирован.")
  208: (princ)
