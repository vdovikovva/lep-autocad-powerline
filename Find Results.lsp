  187: ;
  188: ; LEP:PlacePolesOnRoute
  189: ;
  190: ; Основная функция установки опор.
  191: ;
  192: ;=====================================================================
  193: 
  194: 
  195: (defun LEP:PlacePolesOnRoute (RouteEnt / Vertices Point PoleType PoleEnt RouteData RouteID i)
  196:     ;; Читаем XDATA полилинии, чтобы получить её честный RouteID
  197:     ;; Извлекаем группу 1001 (LEP_DATA) и находим сохраненный ID
  198:     (setq RouteData (assoc -3 (entget RouteEnt '("LEP_DATA"))))
  199:     (if RouteData
  200:         (setq RouteID (cdr (nth 2 (car (cdr RouteData))))) ; Достаем сохраненный ID маршрута
  201:         (setq RouteID "LEP_ROUTE_UNKNOWN")
  202:     )
  203:     
  204:     (setq Vertices (LEP:GetVertices RouteEnt))
  205:     (setq i 0)
  206: 
  207:     (foreach Point Vertices
  208:         (princ (strcat "\nВершина №" (itoa (+ i 1))))
  209:         (setq PoleType (LEP:GetPoleType))
  210:         
  211:         (if PoleType
  212:             (progn
  213:                 ;; Вставляем блок
  214:                 (setq PoleEnt (LEP:InsertPole Point PoleType))
  215:                 (if PoleEnt
  216:                     (progn
  217:                         ;; Накладываем геометрическую зависимость совмещения.
  218:                         ;; Передаем координаты Point, чтобы AutoCAD Mac точно определил точку связывания
  219:                         (command "_.GEOMCONSTRAINT" "_COincident" PoleEnt Point RouteEnt Point "")
  220:                         
  221:                         ;; Записываем данные в базу чертежа
  222:                         (LEP:AddPoleData PoleEnt RouteID PoleType)
  223:                     )
  224:                 )
  225:             )
  226:         )
  227:         (setq i (+ i 1))
  228:     )
  229: )
  230: 
  231: (defun C:LEP-POLE (/ Route OldOs OldError)
  232:     (setq OldError *error*)
  233:     (defun *error* (msg)
  234:         (if OldOs (setvar "OSMODE" OldOs))
  235:         (setq *error* OldError)
  236:         (princ (strcat "\nКоманда прервана: " msg))
  237:         (princ)
  238:     )
  239: 
  240:     (LEP:PrintHeader "Установка опор")
  241:     (setq Route (car (entsel "\nВыберите полилинию маршрута: ")))
  242: 
  243:     (if Route
  244:         (progn
  245:             (setq OldOs (getvar "OSMODE"))
  246:             (setvar "OSMODE" 0)
  247: 
  248:             (LEP:PlacePolesOnRoute Route)
  249: 
  250:             (setvar "OSMODE" OldOs)
  251:         )
  252:         (princ "\nМаршрут не выбран.")
  253:     )
  254:     (setq *error* OldError)
  255:     (LEP:PrintFooter)
  256:     (princ)
  257: )
  258: 
  259: 
  260: 
  261: ;=====================================================================
  262: ;
  263: ; ОСНОВНАЯ КОМАНДА
  264: ;
  265: ;=====================================================================
  266: 
  267: 
  268: ;=====================================================================
  269: ; ОСНОВНАЯ КОМАНДА (С защитой привязок OSMODE)
  270: ;=====================================================================
  271: (defun C:LEP-POLE (/ Route OldOs OldError)
  272: 
  273:     ;; Локальный обработчик ошибок (если нажат ESC)
  274:     (setq OldError *error*)
  275:     (defun *error* (msg)
  276:         (if OldOs (setvar "OSMODE" OldOs)) ; Возвращаем привязки
  277:         (setq *error* OldError)
  278:         (princ (strcat "\nКоманда прервана: " msg))
  279:         (princ)
  280:     )
  281: 
  282:     (LEP:PrintHeader "Установка опор")
  283:     
  284:     (setq Route (car (entsel "\nВыберите полилинию маршрута: ")))
  285: 
  286:     (if Route
  287:         (progn
  288:             ;; Запоминаем текущие привязки и отключаем их (0 = выкл)
  289:             (setq OldOs (getvar "OSMODE"))
  290:             (setvar "OSMODE" 0)
  291: 
  292:             ;; Запуск твоего пошагового выбора опор
  293:             (LEP:PlacePolesOnRoute Route)
  294: 
  295:             ;; Возвращаем исходные привязки после успешного завершения
  296:             (setvar "OSMODE" OldOs)
  297:         )
  298:         (princ "\nМаршрут не выбран.")
  299:     )
  300:     
  301:     ;; Восстанавливаем штатный обработчик ошибок
  302:     (setq *error* OldError)
  303:     (LEP:PrintFooter)
  304:     (princ)
  305: )
  306: 
