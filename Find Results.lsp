    7: 
    8: ;; Функция округления числа вверх до ближайшего кратного (например, до 5.0)
    9: (defun LEP:RoundUp (Value Step / Remainder)
   10:     (setq Remainder (rem Value Step))
   11:     (if (= Remainder 0.0)
   12:         Value
   13:         (+ (- Value Remainder) Step)
   14:     )
   15: )
   16: 
   17: ;; Функция создания текста подписи пролета вдоль линии
   18: (defun LEP:CreateSpanText (P1 P2 TextString / MidPoint Ang)
   19:     ;; Находим центр пролета (средняя точка между опорами)
   20:     (setq MidPoint (list 
   21:         (/ (+ (car P1) (car P2)) 2.0)
   22:         (/ (+ (cadr P1) (cadr P2)) 2.0)
   23:         0.0
   24:     ))
   25:     
   26:     ;; Вычисляем угол наклона линии в радианax
   27:     (setq Ang (angle P1 P2))
   28:     
   29:     ;; Нормализуем угол, чтобы текст не читался "вверх ногами" (переворот при чтении справа налево)
   30:     (if (and (> Ang (/ PI 2.0)) (<= Ang (/ (* 3.0 PI) 2.0)))
   31:         (setq Ang (+ Ang PI))
   32:     )
   33: 
   34:     ;; Вставляем однострочный текст TEXT на слой подписей
   35:     (command "_.TEXT" 
   36:         "_Justify" "_BCenter"       ; Выравнивание по центру снизу (над линией)
   37:         MidPoint                     ; Точка вставки
   38:         *LEP-TextHeight* ; Высота текста из CONFIG
   39:         (angtos Ang 0 4)             ; Угол поворота в градусах текущей системы
   40:         TextString                   ; Сам текст подписи
   41:     )
   42: )
   43: 
