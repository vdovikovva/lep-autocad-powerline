  164: ;
  165: ; LEP:SetData
  166: ;
  167: ; Записывает данные в объект.
  168: ;
  169: ; Формат входных данных:
  170: ;
  171: ; (
  172: ;  ("TYPE" . "POLE")
  173: ;  ("MODEL" . "П20-3Н")
  174: ;  ("STATUS" . "PROJECT")
  175: ; )
  176: ;
  177: ;=====================================================================
  178: 
  179: 
  180: (defun LEP:SetData
  181: 
  182:     (
  183: 
  184:         Ent
  185: 
  186:         DataList
  187: 
  188:         /
  189: 
  190:         OldData
  191: 
  192:         NewData
  193: 
  194:     )
  195: 
  196: 
  197:     (LEP:RegisterApp)
  198: 
  199: 
  200: 
  201:     (setq NewData
  202: 
  203:         (list
  204: 
  205:             (cons
  206: 
  207:                 1001
  208: 
  209:                 *LEP-RegApp*
  210: 
  211:             )
  212: 
  213:         )
  214: 
  215:     )
  216: 
  217: 
  218: 
  219:     (foreach Item DataList
  220: 
  221:         (setq NewData
  222: 
  223:             (append
  224: 
  225:                 NewData
  226: 
  227:                 (list
  228: 
  229:                     (cons
  230: 
  231:                         1000
  232: 
  233:                         (strcat
  234: 
  235:                             (car Item)
  236: 
  237:                             "="
  238: 
  239:                             (cdr Item)
  240: 
  241:                         )
  242: 
  243:                     )
  244: 
  245:                 )
  246: 
  247:             )
  248: 
  249:         )
  250: 
  251:     )
  252: 
  253: 
  254: 
  255:     (regapp *LEP-RegApp*)
  256: 
  257: 
  258: 
  259:     (entmod
  260: 
  261:         (append
  262: 
  263:             (entget Ent)
  264: 
  265:             NewData
  266: 
  267:         )
  268: 
  269:     )
  270: 
  271: 
  272: 
  273:     (entupd Ent)
  274: 
  275: 
  276: 
  277: )
  278: 
  279: 
  280: 
  281: ;=====================================================================
