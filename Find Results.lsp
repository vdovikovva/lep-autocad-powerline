   93: ;=====================================================================
   94: ;
   95: ; LEP:CreateRouteID
   96: ;
   97: ; Создание номера маршрута.
   98: ;
   99: ;=====================================================================
  101: 
  102: (defun LEP:CreateRouteID (/ ID)
  103: 
  104: 
  105:     (setq ID
  106: 
  107:         (strcat
  108: 
  109:             "LEP_ROUTE_"
  110: 
  111:             (substr
  112: 
  113:                 (strcat
  114: 
  115:                     "0000"
  116: 
  117:                     (itoa *LEP-RouteCounter*)
  118: 
  119:                 )
  120: 
  121:                 (-
  122: 
  123:                     (strlen
  124: 
  125:                         (strcat
  126: 
  127:                             "0000"
  128: 
  129:                             (itoa *LEP-RouteCounter*)
  130: 
  131:                         )
  132: 
  133:                     )
  134: 
  135:                     3
  136: 
  137:                 )
  138: 
  139:             )
  140: 
  141:         )
  142: 
  143:     )
  144: 
  145: 
  146:     (setq *LEP-RouteCounter*
  147: 
  148:         (1+
  149: 
  150:             *LEP-RouteCounter*
  151: 
  152:         )
  153: 
  154:     )
  155: 
  156: 
  157:     ID
  158: 
  159: )
  160: 
  161: 
