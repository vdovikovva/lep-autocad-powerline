  328:                 1000
  329: 
  330:             )
  331: 
  332:             (setq Result
  333: 
  334:                 (append
  335: 
  336:                     Result
  337: 
  338:                     (list
  339: 
  340:                         (cdr Item)
  341: 
  342:                     )
  343: 
  344:                 )
  345: 
  346:             )
  347: 
  348:         )
  349: 
  350:     )
  351: 
  352: 
  353:     Result
  354: 
  355: )
