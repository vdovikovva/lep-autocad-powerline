   47: (defun C:LEP-SPAN (/ RouteEnt Vertices TotalVertices i P1 P2 RealLen RoundLen Choice WireType TargetLayer TextLabel)
   48:     (LEP:PrintHeader "Обработка пролетов и подписи")
   49: 
   50:     (setq RouteEnt (car (entsel "\nВыберите полилинию маршрута для расчета пролетов: ")))
   51: 
   52:     (if (and RouteEnt (= (cdr (assoc 0 (entget RouteEnt))) "LWPOLYLINE"))
   53:         (progn
   54:             ;; 1. Запрос типа прокладки линии
   55:             (initget "1 2")
   56:             (setq Choice (getkword "\nТип прокладки: [1 - Воздух (ВЛ) / 2 - Земля (КЛ)]: "))
   57:             
   58:             (if (= Choice "1")
   59:                 (progn
   60:                     (setq WireType "СИП-2 95") ; В дальнейшем можно сделать выбор из CONFIG
   61:                     (setq TargetLayer *LEP-Layer-Proj-VL*)
   62:                 )
   63:                 (progn
   64:                     (setq WireType "Кабель 120")
   65:                     (setq TargetLayer *LEP-Layer-Proj-KL*)
   66:                 )
   67:             )
   68: 
   69:             ;; 2. Меняем слой самого маршрута на правильный тип прокладки
   70:             (command "_.CHPROP" RouteEnt "" "_Layer" TargetLayer "")
   71: 
   72:             ;; 3. Бежим по сегментам полилинии и ставим подписи
   73:             (setq Vertices (LEP:GetVertices RouteEnt))
   74:             (setq TotalVertices (length Vertices))
   75:             (setq i 0)
   76: 
   77:             (LEP:SetCurrentLayer *LEP-Layer-Text*)
   78: 
   79:             (repeat (- TotalVertices 1)
   80:                 (setq P1 (nth i Vertices))
   81:                 (setq P2 (nth (+ i 1) Vertices))
   82:                 
   83:                 ;; Считаем честное расстояние (1 ед. = 1 метр благодаря LEP-SCALE)
   84:                 (setq RealLen (distance P1 P2))
   85:                 
   86:                 ;; Округляем вверх по правилу из CONFIG (например, до ближайших 5 метров)
   87:                 (setq RoundLen (fix (LEP:RoundUp RealLen *LEP-LengthRound*)))
   88: 
   89:                 ;; Собираем сквозную инженерную подпись под ЧБ-печать
   90:                 (setq TextLabel (strcat *LEP-TextPrefix-Proj* WireType " - " (itoa RoundLen) " м"))
   91:                 
   92:                 ;; Генерируем текст на чертеже
   93:                 (LEP:CreateSpanText P1 P2 TextLabel)
   94: 
   95:                 (setq i (1+ i))
   96:             )
   97:             (princ (strcat "\nУспешно обработано пролетов: " (itoa i)))
   98:         )
   99:         (princ "\nОшибка: Нужно выбрать объект типа Полилиния.")
  100:     )
  101: 
  102:     (LEP:PrintFooter)
  103:     (princ)
  104: )
  105: 
  106: (princ "\nLEP-SPAN v0.1 загружен.")
  107: (princ)
