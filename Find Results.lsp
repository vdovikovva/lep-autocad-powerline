    1: ;=====================================================================
    2: ; ПРОЕКТ:       LEP (Автоматизация проектирования ЛЭП)
    3: ; ФАЙЛ:         LEP-SCALE.LSP
    4: ; ВЕРСИЯ:       0.2
    5: ; НАЗНАЧЕНИЕ:   Калибровка растровой подложки (скана, карты, кадастра).
    6: ;               Приводит чертеж к масштабу 1 единица = 1 метр 
    7: ;               на основе графической масштабной линейки.
    8: ;=====================================================================
    9: 
   10: (defun C:LEP-SCALE ( / ImgEnt P1 P2 MeasDist InputVal RealDist OldOs OldError )
   11: 
   12:     ;-----------------------------------------------------------------
   13:     ; ЛОКАЛЬНЫЙ ОБРАБОТЧИК ОШИБОК
   14:     ; Предотвращает поломку настроек AutoCAD при аварийном нажатии ESC
   15:     ;-----------------------------------------------------------------
   16:     (setq OldError *error*) ; Запоминаем стандартный обработчик ошибок
   17:     (defun *error* (msg)
   18:         (if OldOs (setvar "OSMODE" OldOs)) ; Гарантированно возвращаем привязки
   19:         (setq *error* OldError)            ; Восстанавливаем обработчик
   20:         (princ (strcat "\n[LEP-SCALE] Команда прервана: " msg))
   21:         (princ)
   22:     )
   23: 
   24:     ; Выводим фирменную шапку проекта из LEP-UTILS
   25:     (LEP:PrintHeader "Калибровка масштаба подложки")
   26:     
   27:     ;-----------------------------------------------------------------
   28:     ; ШАГ 1: ВЫБОР ОБЪЕКТА ПОДЛОЖКИ
   29:     ;-----------------------------------------------------------------
   30:     ; entsel приостанавливает выполнение и ждет клика по объекту.
   31:     ; Возвращает список: (ename (координаты клика)). Нам нужен только ename -> car.
   32:     (setq ImgEnt (car (entsel "\nВыберите изображение подложки (карту/кадастр): ")))
   33:     
   34:     (if ImgEnt
   35:         (progn
   36:             ; Временная деактивация объектных привязок (OSMODE = 0).
   37:             ; Это критично: при клике по картинке курсор не должен магнититься 
   38:             ; к случайным векторам геометрии, лежащим рядом.
   39:             (setq OldOs (getvar "OSMODE"))
   40:             (setvar "OSMODE" 0)
   41: 
   42:             ;---------------------------------------------------------
   43:             ; ШАГ 2: ФИКСАЦИЯ ОПОРНЫХ ТОЧЕК НА КАРТЕ
   44:             ;---------------------------------------------------------
   45:             ; getpoint запрашивает координаты. Передача точки P1 во второй вызов
   46:             ; включает "резиновый канат" (визуальную линию связи) от P1 к курсору.
   47:             (setq P1 (getpoint "\nУкажите ПЕРВУЮ точку на масштабной линейке карты: "))
   48:             (setq P2 (getpoint P1 "\nУкажите ВТОРУЮ точку на масштабной линейке карты: "))
   49:             
   50:             ; Возвращаем привязки инженеру сразу после сбора графических данных
   51:             (setvar "OSMODE" OldOs)
   52:             (setq OldOs nil) ; Обнуляем переменную, чтобы *error* её не трогал
   53: 
   54:             ; Вычисляем текущее расстояние в абстрактных единицах AutoCAD
   55:             (setq MeasDist (distance P1 P2))
   56:             (princ (strcat "\nИзмеренная длина в чертеже: " (rtos MeasDist 2 4) " ед."))
   57:             
   58:             ;---------------------------------------------------------
   59:             ; ШАГ 3: ИНТЕРАКТИВНЫЙ ЗАПРОС РЕАЛЬНОЙ ДЛИНЫ
   60:             ;---------------------------------------------------------
   61:             ; Механика initget + getreal:
   62:             ; Строка "10 20 50 100" задает жесткие макросы-ключи для быстрого ввода.
   63:             ; Если инженер введет одно из этих чисел или выберет в контекстном меню,
   64:             ; getreal вернет это значение как СТРОКУ (например, "50").
   65:             ; Если инженер введет ЛЮБОЕ ДРУГОЕ число (например, 25), getreal
   66:             ; поймет, что это свободный ввод, и вернет ЧИСЛО типа REAL (25.0).
   67:             (initget "10 20 50 100")
   68:             (setq InputVal (getreal "\nВведите реальное расстояние в метрах [10/20/50/100] или укажите своё: "))
   69:             
   70:             ; Анализируем тип возвращенного значения для предотвращения сбоя типизации
   71:             (cond
   72:                 ; Вариант А: Пользователь выбрал ключ из initget -> пришла строка
   73:                 ((= (type InputVal) 'STR)
   74:                     (setq RealDist (atof InputVal)) ; Парсим строку в вещественное число
   75:                 )
   76:                 ; Вариант Б: Пользователь ввел свое уникальное число -> пришло число
   77:                 ((= (type InputVal) 'REAL)
   78:                     (setq RealDist InputVal)
   79:                 )
   80:                 ; Вариант В: Пользователь нажал Enter без ввода (отмена)
   81:                 (t (setq RealDist nil))
   82:             )
   83:             
   84:             ;---------------------------------------------------------
   85:             ; ШАГ 4: МАТЕМАТИЧЕСКОЕ МАСШТАБИРОВАНИЕ ОБЪЕКТА
   86:             ;---------------------------------------------------------
   87:             ; Проверяем валидность полученного значения
   88:             (if (and RealDist (> RealDist 0.0))
   89:                 (progn
   90:                     ; Вызов встроенной команды SCALE через командный интерфейс AutoCAD.
   91:                     ; Механика Опции Ссылка (_Reference):
   92:                     ; Исходная длина (MeasDist) заменяется Новой длиной (RealDist).
   93:                     ; Использование префиксов "_." и "_" гарантирует корректный запуск
   94:                     ; команды на любых языковых версиях AutoCAD и на macOS.
   95:                     (command "_.SCALE" 
   96:                              ImgEnt             ; Выбираем наш объект
   97:                              ""                 ; Нажимаем Enter для завершения выбора объектов
   98:                              P1                 ; Базовая точка масштабирования (останется на месте)
   99:                              "_Reference"       ; Включаем режим масштабирования по ссылке
  100:                              MeasDist           ; Передаем старый размер
  101:                              RealDist           ; Передаем новый целевой размер в метрах
  102:                     )
  103:                     
  104:                     ; Печать лога калибровки для инженерного контроля
  105:                     (princ "\n==========================================")
  106:                     (princ (strcat "\n[УСПЕХ] Масштаб подложки откалиброван."))
  107:                     (princ (strcat "\n Пропорция: " (rtos MeasDist 2 2) " ед. -> превращены в " (rtos RealDist 2 2) " м."))
  108:                     (princ "\n Теперь 1 единица чертежа строго равна 1 метру.")
  109:                     (princ "\n==========================================")
  110:                 )
  111:                 (princ "\n[ОТМЕНА] Калибровка не выполнена: некорректное расстояние.")
  112:             )
  113:         )
  114:         (princ "\n[ОШИБКА] Объект подложки не выбран.")
  115:     )
  116:     
  117:     ; Восстанавливаем стандартную систему обработки ошибок AutoCAD
  118:     (setq *error* OldError)
  119:     (LEP:PrintFooter)
  120:     (princ)
  121: )
  122: 
  123: ;; Информируем консоль о штатной загрузке модуля
  124: (princ "\nМодуль LEP-SCALE v0.2 успешно загружен.")
  125: (princ)
