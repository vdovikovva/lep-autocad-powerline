    1: ;=====================================================================
    2: ;
    3: ;   ПРОЕКТ:
    4: ;   LEP
    5: ;
    6: ;   ФАЙЛ:
    7: ;   LEP-POLE.LSP
    8: ;
    9: ;   ВЕРСИЯ:
   10: ;   0.1
   11: ;
   12: ;   НАЗНАЧЕНИЕ:
   13: ;
   14: ;   Автоматическая установка опор на вершины
   15: ;   проектируемого маршрута ЛЭП.
   16: ;
   17: ;=====================================================================
   18: 
   19: 
   20: 
   21: ;=====================================================================
   22: ;
   23: ; НАСТРОЙКИ
   24: ;
   25: ;=====================================================================
   26: 
   27: 
   28: ;; Временные имена вариантов опор.
   29: ;;
   30: ;; После подключения materials.csv
   31: ;; этот список будет заменен внешним файлом.
   32: 
   33: (setq *LEP-PoleTypes*
   34: 
   35:     '(
   36:         ("П20-3Н"  . "П20-3Н")
   37:         ("А20-3Н"  . "А20-3Н")
   38:         ("УА20-3Н" . "УА20-3Н")
   39:         ("А23"     . "А23")
   40:      )
   41: 
   42: )
   43: 
   44: 
   45: 
   46: ;=====================================================================
   47: ;
   48: ; LEP:GetPoleType
   49: ;
   50: ; Запрос типа опоры у пользователя.
   51: ;
   52: ; Возвращает имя блока.
   53: ;
   54: ;=====================================================================
   55: 
   56: 
   57: (defun LEP:GetPoleType (/ Choice)
   58: 
   59:     (initget "1 2 3 4")
   60: 
   61:     (setq Choice
   62: 
   63:         (getkword
   64: 
   65:             "\nВыберите опору [1-П20-3Н/2-А20-3Н/3-УА20-3Н/4-А23]: "
   66: 
   67:         )
   68: 
   69:     )
   70: 
   71: 
   72:     (cond
   73: 
   74:         ((= Choice "1")
   75:             "П20-3Н"
   76:         )
   77: 
   78:         ((= Choice "2")
   79:             "А20-3Н"
   80:         )
   81: 
   82:         ((= Choice "3")
   83:             "УА20-3Н"
   84:         )
   85: 
   86:         ((= Choice "4")
   87:             "А23"
   88:         )
   89: 
   90:     )
   91: 
   92: )
   93: 
   94: 
   95: 
   96: ;=====================================================================
   97: ;
   98: ; LEP:InsertPole
   99: ;
  100: ; Вставка блока опоры.
  101: ;
  102: ; Вход:
  103: ;
  104: ; Point - координата вершины
  105: ; BlockName - имя блока
  106: ;
  107: ;=====================================================================
  108: 
  109: 
  110: (defun LEP:InsertPole
  111: 
  112:     (
  113: 
  114:         Point
  115: 
  116:         BlockName
  117: 
  118:         /
  119: 
  120:         OldLayer
  121: 
  122:         Ent
  123: 
  124:     )
  125: 
  126: 
  127:     ;; Запоминаем слой
  128: 
  129:     (setq OldLayer
  130:         (getvar "CLAYER")
  131:     )
  132: 
  133: 
  134:     ;; Переключаемся на слой опор
  135: 
  136:     (LEP:SetCurrentLayer
  137:         *LEP-Layer-Proj-Pole*
  138:     )
  139: 
  140: 
  141:     ;; Вставка блока
  142: 
  143:     (command
  144: 
  145:         "_.-INSERT"
  146: 
  147:         BlockName
  148: 
  149:         Point
  150: 
  151:         1
  152: 
  153:         1
  154: 
  155:         0
  156: 
  157:     )
  158: 
  159: 
  160:     ;; Получаем последний объект
  161: 
  162:     (setq Ent
  163: 
  164:         (entlast)
  165: 
  166:     )
  167: 
  168: 
  169:     ;; Возвращаем слой
  170: 
  171:     (setvar
  172: 
  173:         "CLAYER"
  174: 
  175:         OldLayer
  176: 
  177:     )
  178: 
  179: 
  180:     Ent
  181: 
  182: )
