   60: ; AutoCAD требует регистрации имени.
   61: ;
   62: ;=====================================================================
   63: 
   64: 
   65: (defun LEP:RegisterApp (/)
   66: 
   67:     (if
   68: 
   69:         (not
   70: 
   71:             (tblsearch
   72: 
   73:                 "APPID"
   74: 
   75:                 *LEP-RegApp*
   76: 
   77:             )
   78: 
   79:         )
   80: 
   81:         (regapp
