;=====================================================================
;
;   ПРОЕКТ:
;   LEP
;
;   ФАЙЛ:
;   LEP-SETUP.LSP
;
;   ВЕРСИЯ:
;   0.1
;
;   НАЗНАЧЕНИЕ:
;
;   Подготавливает чертёж к работе.
;
;   Создаёт все необходимые слои проекта.
;
;   Если слой уже существует —
;   повторно он не создаётся.
;
;   После завершения выводится краткий отчёт.
;
;=====================================================================



;=====================================================================
;                       СЛУЖЕБНАЯ ФУНКЦИЯ
;=====================================================================
;
; Создание слоя.
;
; Если слой уже существует —
; функция ничего не делает.
;
;=====================================================================

(defun LEP:CreateLayer (LayerName LayerColor /)

    (if (not (tblsearch "LAYER" LayerName))

        (progn

            (command
                "_.LAYER"

                "_Make"
                LayerName

                "_Color"
                LayerColor
                LayerName

                ""

            )

            (princ
                (strcat
                    "\nСоздан слой: "
                    LayerName
                )
            )

        )

        (princ
            (strcat
                "\nУже существует: "
                LayerName
            )
        )

    )

)



;=====================================================================
;                       СЛУЖЕБНАЯ ФУНКЦИЯ
;=====================================================================
;
; Выключает печать слоя (Plot = No) - НЕЗАВИСИМО от того, создан он
; только что или уже был. Используется для служебного слоя маршрута
; LEP-ROUTE-SERVICE: даже если пользователь забудет спрятать его
; командой LEP-ROUTEVIS перед печатью, на бумаге он всё равно не
; появится.
;
;=====================================================================

(defun LEP:SetLayerNoPlot (LayerName /)
    (command "_.-layer" "_Plot" "_No" LayerName "")
)



;=====================================================================
;
;                     ОСНОВНАЯ КОМАНДА
;
;=====================================================================

(defun C:LEP-SETUP (/)

    (princ "\n")
    (princ "========================================")
    (princ "\nПодготовка чертежа LEP")
    (princ "\n========================================")



    ;;------------------------------------------------------------
    ;; Подложка
    ;;------------------------------------------------------------

    (LEP:CreateLayer
        *LEP-Layer-Kadastr*
        *LEP-Color-Kadastr*
    )



    ;;------------------------------------------------------------
    ;; Служебная линия маршрута (не ВЛ/КЛ, только для констрейнтов)
    ;;------------------------------------------------------------

    (LEP:CreateLayer
        *LEP-Layer-Route*
        *LEP-Color-Proj*
    )
    (LEP:SetLayerNoPlot *LEP-Layer-Route*)



    ;;------------------------------------------------------------
    ;; Воздушные линии
    ;;------------------------------------------------------------

    (LEP:CreateLayer
        *LEP-Layer-Proj-VL*
        *LEP-Color-Proj-VL*
    )

    (LEP:CreateLayer
        *LEP-Layer-Exist-VL*
        *LEP-Color-Exist*
    )



    ;;------------------------------------------------------------
    ;; Кабельные линии
    ;;------------------------------------------------------------

    (LEP:CreateLayer
        *LEP-Layer-Proj-KL*
        *LEP-Color-Proj-KL*
    )

    (LEP:CreateLayer
        *LEP-Layer-Exist-KL*
        *LEP-Color-Exist*
    )



    ;;------------------------------------------------------------
    ;; Опоры
    ;;------------------------------------------------------------

    (LEP:CreateLayer
        *LEP-Layer-Proj-Pole*
        *LEP-Color-Proj*
    )

    (LEP:CreateLayer
        *LEP-Layer-Exist-Pole*
        *LEP-Color-Exist*
    )



    ;;------------------------------------------------------------
    ;; Подстанции
    ;;------------------------------------------------------------

    (LEP:CreateLayer
        *LEP-Layer-Proj-MTP*
        *LEP-Color-Proj*
    )

    (LEP:CreateLayer
        *LEP-Layer-Proj-RLK*
        *LEP-Color-Proj*
    )

    (LEP:CreateLayer
        *LEP-Layer-Proj-TP*
        *LEP-Color-Proj*
    )

    (LEP:CreateLayer
        *LEP-Layer-Exist-TP*
        *LEP-Color-Exist*
    )



    ;;------------------------------------------------------------
    ;; Текст
    ;;------------------------------------------------------------

    (LEP:CreateLayer
        *LEP-Layer-Text*
        *LEP-Color-Text*
    )



    ;;------------------------------------------------------------
    ;; Размеры
    ;;------------------------------------------------------------

    (LEP:CreateLayer
        *LEP-Layer-Dim*
        *LEP-Color-Dim*
    )



    (princ)

    (princ "\n")
    (princ "========================================")
    (princ "\nПодготовка завершена.")
    (princ "\n========================================")

    (princ)

)