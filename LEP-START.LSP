;=====================================================================
;
;   ПРОЕКТ:      LEP
;   ФАЙЛ:        LEP-START.LSP
;   ВЕРСИЯ:      0.4  (испр. Claude)
;
;   ИСПРАВЛЕНО В ЭТОЙ ВЕРСИИ:
;   В списке загрузки не хватало ДВУХ файлов, которые реально
;   существуют на диске, но никогда не подключались:
;     - LEP-DATA.LSP   (там LEP:SetData/GetData/AddRoute и т.д. -
;                        на них держится вся передача данных между
;                        маршрутом, опорами и будущей ведомостью)
;     - LEP-ROUTE.LSP  (там C:LEP-ROUTE - команда черчения трассы,
;                        именно её вам и не хватило)
;   Из-за этого LEP-ROUTE была "невидимой" командой, а LEP-POLE
;   в свою очередь всё равно упала бы следующей, т.к. вызывает
;   функции из LEP-DATA.LSP, которых не было в памяти.
;
;   Также: попытка через Support File Search Path у вас не сработала -
;   пока не разбираемся почему отдельно (это не критично, раз есть
;   рабочий обходной путь). Загрузчик по-прежнему ищет файлы через
;   findfile, который среди прочего смотрит и в папку текущего
;   чертежа - именно поэтому перенос DWG в папку с модулями помог.
;   Пока держите DWG в этой же папке, к пути возвращаемся отдельно,
;   если понадобится ведомость на компьютере коллеги.
;
;   НАЗНАЧЕНИЕ:
;   Главный загрузчик проекта LEP. Пользователь загружает только этот
;   файл (через APPLOAD). Все остальные модули подключаются автоматически.
;
;=====================================================================
 
 
;=====================================================================
;
;   АВТОРЕГИСТРАЦИЯ ПАПКИ КАК ДОВЕРЕННОЙ (TRUSTEDPATHS)
;
;   Без этого AutoCAD спрашивает подтверждение на КАЖДЫЙ отдельный
;   файл LEP-*.LSP при загрузке (это его система безопасности,
;   SECURELOAD/TRUSTEDPATHS, а не наш баг). Регистрируем папку один
;   раз здесь - дальше подтверждать нужно будет только самую первую
;   загрузку LEP-START.LSP через APPLOAD, а все вложенные load
;   внутри LEP:LoadFile пойдут уже тихо.
;
;   УНИВЕРСАЛЬНО (без хардкода пути и имени пользователя):
;   Путь берём из (getvar "DWGPREFIX") - это папка, где сохранён
;   ТЕКУЩИЙ ЧЕРТЁЖ. Это работает при ОДНОМ условии: DWG должен лежать
;   в той же папке, что и модули LEP-*.LSP (вы уже так и делаете -
;   именно это в своё время помогло findfile их находить). Работает
;   одинаково и у вас на Mac, и у коллеги на Windows - каждый просто
;   держит свой DWG рядом со своей копией папки LEP LSP, и путь
;   определяется сам, без единой правки кода.
;
;   ЕСЛИ чертёж НИ РАЗУ не сохранялся - DWGPREFIX может быть пустым
;   или указывать не туда. В этом случае просто сохраните чертёж
;   (Save As) в папку с модулями LEP один раз - и всё заработает.
;
;=====================================================================
 
(setq *LEP-TrustPath* (getvar "DWGPREFIX"))
 
(if (or (not *LEP-TrustPath*) (= *LEP-TrustPath* ""))
    (princ "\n[LEP-START] ВНИМАНИЕ: чертёж ещё не сохранён - не могу определить папку для TRUSTEDPATHS. Сохраните DWG в папку с модулями LEP и загрузите LEP-START.LSP заново.")
    (progn
        (if (getvar "TRUSTEDPATHS")
            (setq LEP-CurTrusted (getvar "TRUSTEDPATHS"))
            (setq LEP-CurTrusted "")
        )
 
        (if (not (wcmatch LEP-CurTrusted (strcat "*" *LEP-TrustPath* "*")))
            (setvar "TRUSTEDPATHS"
                (strcat
                    LEP-CurTrusted
                    (if (= LEP-CurTrusted "") "" ";")
                    *LEP-TrustPath*
                )
            )
        )
    )
)
 
 
(defun LEP:LoadFile (FileName / FullPath)
 
    (setq FullPath (findfile FileName))
 
    (if FullPath
        (progn
            (load FullPath)
            (princ (strcat "\nЗагружен: " FileName))
        )
        (princ
            (strcat
                "\nНЕ НАЙДЕН: " FileName
                "  -- положите DWG в ту же папку, что и модули LEP"
                " (пока используем этот способ вместо Support Path)."
            )
        )
    )
 
)
 
 
;=====================================================================
;
; ЗАПУСК ЗАГРУЗКИ
;
; ПОРЯДОК ВАЖЕН! Каждый следующий модуль может использовать функции
; из предыдущих.
;
; 1. CONFIG      настройки
; 2. UTILS       общие функции
; 3. DATA        хранение данных объектов (XDATA) -- ДОБАВЛЕНО
; 4. SETUP       подготовка чертежа (слои и т.д.)
; 5. POLYLINE    общие функции работы с полилиниями (вершины и т.д.)
; 6. ROUTE       команда черчения трассы ЛЭП -- ДОБАВЛЕНО
; 7. POLE        установка опор на трассу
; 8. SPAN        работа с пролётами
; 9. SCALE       установка масштаба подложки
; 10. REPORT     ведомость опор, кабелей и проводов
;
;=====================================================================
 
 
(princ "\n")
(princ "======================================")
(princ "\n Загрузка системы LEP")
(princ "\n======================================")
 
(LEP:LoadFile "LEP-CONFIG.LSP")
(LEP:LoadFile "LEP-UTILS.LSP")
(LEP:LoadFile "LEP-DATA.LSP")
(LEP:LoadFile "LEP-SETUP.LSP")
(LEP:LoadFile "LEP-POLYLINE.LSP")
(LEP:LoadFile "LEP-ROUTE.LSP")
(LEP:LoadFile "LEP-POLE.LSP")
(LEP:LoadFile "LEP-SPAN.LSP")
(LEP:LoadFile "LEP-SCALE.LSP")
(LEP:LoadFile "LEP-REPORT.LSP")
 
(princ "\n")
(princ "======================================")
(princ "\n LEP загружен успешно")
(princ "\n Команды:")
(princ "\n LEP-SETUP")
(princ "\n LEP-ROUTE")
(princ "\n LEP-POLE")
(princ "\n LEP-SPAN")
(princ "\n LEP-SCALE")
(princ "\n LEP-REPORT")
(princ "\n======================================")
 
(princ)