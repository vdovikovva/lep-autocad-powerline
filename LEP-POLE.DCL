//=====================================================================
//  LEP-POLE.DCL
//  Диалог выбора типа опоры (список берётся из *LEP-PoleTypes* в
//  LEP-CONFIG.LSP и заполняется кодом в момент открытия диалога).
//=====================================================================

lep_pole_dialog : dialog {
    label = "Выбор типа опоры";
    : list_box {
        key = "pole_list";
        width = 30;
        height = 12;
        fixed_width = true;
    }
    spacer;
    ok_cancel;
}
