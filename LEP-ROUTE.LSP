;=====================================================================
;
;   ПРОЕКТ:
;   LEP
;
;   ФАЙЛ:
;   LEP-ROUTE.LSP
;
;   ВЕРСИЯ:
;   0.2
;
;   НАЗНАЧЕНИЕ:
;
;   Создание маршрута проектируемой линии.
;
;   Алгоритм:
;
;   1. Пользователь рисует трассу PLINE.
;   2. Программа присваивает ей уникальный ID.
;   3. ID записывается внутрь DWG.
;   4. Далее к этому маршруту будут привязаны:
;
;      - опоры;
;      - пролеты;
;      - кабели;
;      - оборудование.
;
;=====================================================================



;=====================================================================
;
; КОМАНДА:
;
; LEP-ROUTE
;
;=====================================================================


(defun C:LEP-ROUTE

    (

        /

        OldLayer

        RouteEnt

        RouteID

    )



    (LEP:PrintHeader

        "Создание маршрута ЛЭП"

    )



    ;---------------------------------------------------------------
    ; Запоминаем текущий слой
    ;---------------------------------------------------------------

    (setq OldLayer

        (getvar "CLAYER")

    )



    ;---------------------------------------------------------------
    ; Переключаемся на слой проектируемой ВЛ
    ;---------------------------------------------------------------

    (LEP:SetCurrentLayer

        *LEP-Layer-Proj-VL*

    )


    ;---------------------------------------------------------------
    ; Создание полилинии
    ;---------------------------------------------------------------

    (LEP:SetCurrentLayer *LEP-Layer-Proj-VL*)
    (princ "\nРисуйте трассу ЛЭП. После завершения нажмите Enter.")
    
    (command "_.PLINE")
    ;; Цикл ожидания, пока пользователь не завершит команду PLINE
    (while (> (getvar "CMDACTIVE") 0)
        (command pause)
    )

    ;; Теперь это гарантированно наша новая полилиния трассы
    (setq RouteEnt (entlast))



    ;---------------------------------------------------------------
    ; Проверка результата
    ;---------------------------------------------------------------

    (if RouteEnt


        (progn



            ;-------------------------------------------------------
            ; Создаем ID маршрута
            ;-------------------------------------------------------

            (setq RouteID

                (LEP:AddRoute

                    RouteEnt

                )

            )



            (princ

                "\nСоздан маршрут: "

            )


            (princ RouteID)



            ;-------------------------------------------------------
            ; Сохраняем текущий маршрут
            ;-------------------------------------------------------

            (setq *LEP-CurrentRoute*

                RouteEnt

            )



        )


        (princ

            "\nМаршрут не создан."

        )


    )



    ;---------------------------------------------------------------
    ; Возвращаем исходный слой
    ;---------------------------------------------------------------

    (setvar

        "CLAYER"

        OldLayer

    )



    (LEP:PrintFooter)



    (princ)

)



(princ "\nLEP-ROUTE v0.2 загружен.")

(princ)