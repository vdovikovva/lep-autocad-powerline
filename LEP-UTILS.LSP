;=====================================================================



;=====================================================================
;                     LEP:LayerExists
;
; Проверяет существование слоя.
;
; Вход:
;   LayerName
;
; Выход:
;   T
;   nil
;
;=====================================================================

(defun LEP:LayerExists (LayerName)

    (if (tblsearch "LAYER" LayerName)
        T
        nil
    )

)



;=====================================================================
;                     LEP:BlockExists
;
; Проверяет наличие блока.
;
;=====================================================================

(defun LEP:BlockExists (BlockName)

    (if (tblsearch "BLOCK" BlockName)
        T
        nil
    )

)



;=====================================================================
;                     LEP:SetCurrentLayer
;
; Делает слой текущим.
;
;=====================================================================

(defun LEP:SetCurrentLayer (LayerName)

    (if (LEP:LayerExists LayerName)

        (setvar "CLAYER" LayerName)

        (princ
            (strcat
                "\nОшибка. Слой "
                LayerName
                " не существует."
            )
        )

    )

)



;=====================================================================
;                     LEP:RoundLength
;
; Округление длины до ближайшего значения.
;
; Например
;
; 22 -> 20
; 23 -> 25
;
; Используется переменная
;
; *LEP-LengthRound*
;
;=====================================================================

(defun LEP:RoundLength (Value /)

    (*

        *LEP-LengthRound*

        (fix

            (+

                (/ Value *LEP-LengthRound*)

                0.5

            )

        )

    )

)



;=====================================================================
;                     LEP:PrintHeader
;
; Красивый заголовок команды.
;
;=====================================================================

(defun LEP:PrintHeader (Title)

    (princ "\n")

    (princ "==========================================")

    (princ
        (strcat
            "\n"
            Title
        )
    )

    (princ "\n==========================================")

)



;=====================================================================
;                     LEP:PrintFooter
;
;=====================================================================

(defun LEP:PrintFooter ()

    (princ "\n==========================================")

    (princ "\nГотово.")

    (princ "\n==========================================")

)



;=====================================================================
;                     LEP:GetDistance
;
; Возвращает расстояние между двумя точками.
;
; Сделано отдельной функцией потому что потом сюда
; можно добавить коэффициенты, проверки и т.п.
;
;=====================================================================

(defun LEP:GetDistance (P1 P2)

    (distance P1 P2)

)



;=====================================================================
;                     LEP:GetStatus
;
; Запрашивает статус объекта: Проект или Существующий. Общая функция
; для LEP-POLE (статус опоры) и LEP-SPAN (статус пролёта) - раньше
; была только в LEP-POLE.LSP, продублировали бы то же самое в
; LEP-SPAN, поэтому вынесено сюда.
;
; ObjectLabel - слово в родительном падеже для промпта, например
; "опоры" или "пролёта" ("Статус опоры [...]" / "Статус пролёта [...]").
;
; Возвращает "PROJECT" или "EXIST".
;=====================================================================

(defun LEP:GetStatus (ObjectLabel / Choice)

    (initget "Проект Сущ")
    (setq Choice
        (getkword (strcat "\nСтатус " ObjectLabel " [Проект/Сущ] <Проект>: "))
    )

    (if (or (not Choice) (= Choice "Проект"))
        "PROJECT"
        "EXIST"
    )

)



;=====================================================================
;                     LEP:Message
;
; Унифицированный вывод сообщений.
;
;=====================================================================

(defun LEP:Message (Text)

    (princ

        (strcat

            "\n[LEP] "

            Text

        )

    )

)



;=====================================================================
;                     LEP:Error
;
; Общий обработчик ошибок.
;
; Пока простой.
;
; Позже сюда добавим восстановление системных
; переменных и откат временных изменений.
;
;=====================================================================

(defun LEP:Error (Msg)

    (princ)

    (princ
        (strcat

            "\nОшибка: "

            Msg

        )
    )

    (princ)

)



(princ "\nLEP-UTILS загружен.")

(princ)