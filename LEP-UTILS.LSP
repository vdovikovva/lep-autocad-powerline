;=====================================================================
;                     LEP:LayerExists
;
; Проверяет существование слоя.
;
; Вход:
;   LayerName
;
; Выход:
;   T
;   nil
;
;=====================================================================

(defun LEP:LayerExists (LayerName)

    (if (tblsearch "LAYER" LayerName)
        T
        nil
    )

)



;=====================================================================
;                     LEP:SetCurrentLayer
;
; Делает слой текущим.
;
;=====================================================================

(defun LEP:SetCurrentLayer (LayerName)

    (if (LEP:LayerExists LayerName)

        (setvar "CLAYER" LayerName)

        (princ
            (strcat
                "\nОшибка. Слой "
                LayerName
                " не существует."
            )
        )

    )

)



;=====================================================================
;                     LEP:PrintHeader
;
; Красивый заголовок команды.
;
;=====================================================================

(defun LEP:PrintHeader (Title)

    (princ "\n")

    (princ "==========================================")

    (princ
        (strcat
            "\n"
            Title
        )
    )

    (princ "\n==========================================")

)



;=====================================================================
;                     LEP:RoundUp
;
; Округление ВВЕРХ до целого (математический "потолок"/ceiling).
; Нужно для длины провода/кабеля с запасом - для закупки материала
; всегда округляем в большую сторону, никогда не в меньшую (иначе
; можно купить впритык и не хватит).
;
; AutoLISP не умеет ceiling из коробки, только fix (обрезает дробную
; часть в сторону нуля) - поэтому: если дробный остаток есть, целая
; часть + 1, если остатка нет (число и так целое) - как есть.
; Сравнение с крошечным эпсилон (1e-9), а не напрямую с 0 - иначе
; накопленная погрешность вещественных чисel (например Value
; получилось 45.00000001 вместо ровно 45.0) ошибочно округлила бы
; вверх лишний раз.
;=====================================================================

(defun LEP:RoundUp (Value / IntPart)

    (setq IntPart (fix Value))

    (if (> (- Value IntPart) 1e-9)
        (1+ IntPart)
        IntPart
    )

)



;=====================================================================
;                     LEP:RoundNearest
;
; Округление ДО БЛИЖАЙШЕГО целого по обычным правилам математики
; (0.5 и больше - вверх, меньше - вниз). Для расстояния между опорами
; на размерной линии (LEP-SPAN) - это просто читаемое число для
; человека, не запас материала, поэтому округляем как в жизни, а не
; всегда вверх.
;=====================================================================

(defun LEP:RoundNearest (Value)

    (fix (+ Value 0.5))

)



;=====================================================================
;                     LEP:RoundLength
;
; ЕДИНОЕ правило округления ДЛИНЫ В МЕТРАХ на весь проект. Все длины
; провода/кабеля/траншеи - и в подписях на чертеже, и в размерных
; линиях, и в ведомости - округляются ТОЛЬКО через эту функцию.
;
; ✅ ДОБАВЛЕНО 2026-08-05. Причина - реальная находка пользователя:
; один и тот же пролёт 46,4958 м был подписан выноской "L=47 м"
; (LEP:RoundUp) и размерной линией "46 м" (LEP:RoundNearest) - два
; разных числа про одну и ту же величину, рядом на одном чертеже.
; Раньше это были два независимых решения в двух разных местах кода,
; и ничто не мешало им разъехаться. Теперь правило одно и живёт здесь.
;
; ПРАВИЛО:
;   Value > *LEP-Round-UpThreshold*  -> вверх     (LEP:RoundUp)
;   Value <= порога                  -> по матем. (LEP:RoundNearest)
;
; Почему не просто "всегда вверх": на коротких длинах это врёт в разы.
; 1,1 м стал бы "2 м" - почти вдвое, и на чертеже такое читается как
; ошибка черчения, а не как запас. На 46 метрах лишние полметра не
; видит никто. Порог и подробное обоснование - в LEP-CONFIG.LSP.
;
; Почему не просто "всегда по математике": длина в ведомости - это
; сколько материала закупать. Округлить вниз значит недокупить, и это
; выяснится уже на монтаже.
;
; ⚠️ Разрыва на пороге НЕТ (проверял специально - пороговые правила
; часто его создают): 4.9 -> 5, ровно 5.0 -> 5, 5.1 -> 6. Функция
; монотонна, больший вход не может дать меньший выход.
;
; ⚠️ НЕ применять к штукам. LEP:RoundUp остаётся отдельной функцией и
; по-прежнему нужен там, где считаются ШТУКИ, а не метры - число труб
; на ГНБ-прокол (LEP-REPORT.LSP, ЭТАП 1.7). Полтрубы не купишь, там
; потолок обязателен ВСЕГДА, никаких порогов. LEP:RoundNearest тоже
; остаётся - он используется как страховка от накопленной погрешности
; при суммировании уже целых чисел (LEP:WriteMasterListBlock).
;=====================================================================

(defun LEP:RoundLength (Value)

    (if (> Value *LEP-Round-UpThreshold*)
        (LEP:RoundUp Value)
        (LEP:RoundNearest Value)
    )

)



