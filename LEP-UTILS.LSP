;=====================================================================
;                     LEP:GetStatus
;
; Запрашивает статус объекта: Проект или Существующий. Общая функция
; для LEP-POLE (статус опоры) и LEP-SPAN (статус пролёта) - раньше
; была только в LEP-POLE.LSP, продублировали бы то же самое в
; LEP-SPAN, поэтому вынесено сюда.
;
; ObjectLabel - слово в родительном падеже для промпта, например
; "опоры" или "пролёта" ("Статус опоры [...]" / "Статус пролёта [...]").
;
; Возвращает "PROJECT" или "EXIST".
;=====================================================================

(defun LEP:GetStatus (ObjectLabel / Choice)

    (initget "Проект Сущ")
    (setq Choice
        (getkword (strcat "\nСтатус " ObjectLabel " [Проект/Сущ] <Проект>: "))
    )

    (if (or (not Choice) (= Choice "Проект"))
        "PROJECT"
        "EXIST"
    )

)



;=====================================================================
;                     LEP:ChooseFromList
;
; Универсальный выбор одного пункта из списка cons-пар (label . value)
; - номером в командной строке, с проверкой диапазона и повторным
; запросом при неверном вводе. Раньше была только в LEP-SPAN.LSP (для
; типа прокладки ВЛ/КЛ и марки провода/кабеля), продублировали бы
; то же самое в LEP-POLE для списка типов опор - поэтому вынесено
; сюда, общая для обоих модулей.
;
; КАЖДЫЙ ПУНКТ - НА ОТДЕЛЬНОЙ СТРОКЕ (раньше все пункты склеивались
; в одну длинную строку через два пробела - с 1-2 проводами это было
; незаметно, а со списком из 10 типов опор превращалось в нечитаемую
; простыню, которая переносится по ширине консоли как попало, а не
; в настоящий столбик).
;
; Возвращает: выбранную пару (cons Label Value) целиком, либо nil
; при отмене (Enter без числа). Если из пары нужно только имя
; (Label) - берите (car Result) у вызывающей стороны.
;=====================================================================

(defun LEP:ChooseFromList (ItemList PromptText / MenuText i Item Choice Result Valid)

    (setq MenuText "")
    (setq i 1)

    (foreach Item ItemList
        (setq MenuText (strcat MenuText "\n" (itoa i) "-" (car Item)))
        (setq i (1+ i))
    )

    (setq Result nil)
    (setq Valid nil)

    (while (not Valid)

        (initget 6)
        (setq Choice (getint (strcat MenuText "\n" PromptText ": ")))

        (cond
            ((not Choice)
             (setq Valid T)
            )
            ((or (< Choice 1) (> Choice (length ItemList)))
             (princ "\nНет такого номера, попробуйте ещё раз.")
            )
            (t
             (setq Result (nth (1- Choice) ItemList))
             (setq Valid T)
            )
        )
    )

    Result
)



;=====================================================================
; LEP:SetMLeaderBackgroundMask
;
; Включает фоновую маску текста у ОДНОЙ конкретной уже созданной
; выноски MULTILEADER (Ent - ename, обычно (entlast) сразу после
; (command "_.MLEADER" ...)). Значения групп - *LEP-MLeader-BgColorValue*/
; *LEP-MLeader-BgScale* в LEP-CONFIG.LSP - см. там ПОДРОБНОЕ
; обоснование, откуда взялись, и почему это НЕ настройка стиля
; (MLEADERSTYLE), а именно каждой отдельной выноски (⚠️ важно - если
; кто-то захочет "сделать один раз на весь чертёж", как остальные
; настройки MLEADER, - так не получится, у стиля нет такого поля).
;
; ⚠️ ПОЧЕМУ ЧЕРЕЗ РАЗБИЕНИЕ СПИСКА, А НЕ ПРОСТО assoc/subst: у сущности
; MULTILEADER вложенная структура (CONTEXT_DATA{ -> LEADER{ ->
; LEADER_LINE{), и коды ПОВТОРЯЮТСЯ (например (292 . 0) встречается
; ДВАЖДЫ - наше поле фона и не связанное с ним поле глубже в LEADER{).
; Обычный subst меняет ВСЕ вхождения с одинаковым значением - живым
; тестом 2026-07-15 поймано, что "слепой" subst портит и то, второе,
; чужое поле тоже. Поэтому здесь правится ТОЛЬКО "голова" списка -
; часть ДО первого маркера (302 . "LEADER{"), где реально лежат нужные
; нам поля (CONTEXT_DATA верхнего уровня) - хвост (сам LEADER{ со всей
; вложенностью) не трогается вообще, коллизия невозможна по построению.
;=====================================================================

(defun LEP:SetMLeaderBackgroundMask (Ent / EData Head Tail)

    (setq EData (entget Ent))
    (setq Head nil)
    (setq Tail EData)

    ;; Собираем "голову" - всё ДО первого маркера начала вложенного
    ;; LEADER{ - именно там, в CONTEXT_DATA верхнего уровня, лежат
    ;; нужные нам поля фона (91/141/291/292).
    (while (and Tail (not (equal (car Tail) (cons 302 "LEADER{"))))
        (setq Head (cons (car Tail) Head))
        (setq Tail (cdr Tail))
    )
    (setq Head (reverse Head))

    (setq Head (subst (cons 291 1) (assoc 291 Head) Head))
    (setq Head (subst (cons 292 1) (assoc 292 Head) Head))
    (setq Head (subst (cons 91 *LEP-MLeader-BgColorValue*) (assoc 91 Head) Head))
    (setq Head (subst (cons 141 *LEP-MLeader-BgScale*) (assoc 141 Head) Head))

    (entmod (append Head Tail))
)



